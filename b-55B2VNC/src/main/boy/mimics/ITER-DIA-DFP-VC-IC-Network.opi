      </foreground_color>
      <format_type>0</format_type>
      <height>27</height>
      <horizontal_alignment>0</horizontal_alignment>
      <name>Text Update Template_7</name>
      <precision>0</precision>
      <precision_from_pv>true</precision_from_pv>
      <pv_name></pv_name>
      <pv_value />
      <rotation_angle>0.0</rotation_angle>
      <rules />
      <scale_options>
        <width_scalable>false</width_scalable>
        <height_scalable>false</height_scalable>
        <keep_wh_ratio>false</keep_wh_ratio>
      </scale_options>
      <scripts>
        <path pathString="EmbeddedJs" checkConnect="true" sfe="false" seoe="false">
          <scriptName>EmbeddedScript</scriptName>
          <scriptText><![CDATA[importPackage(Packages.org.csstudio.opibuilder.scriptUtil);
bdtm0=PVUtil.getLong(pvs[0]);
bdtm1=PVUtil.getLong(pvs[1]);
//java.lang.System.out.println(""+bdtm0);
//java.lang.System.out.println(""+bdtm1);
date=new Date(bdtm0*1000);
widget.setPropertyValue("text",
	date.getUTCFullYear()+"-"+
	("0"+(date.getUTCMonth()+1)).slice(-2)+"-"+
	("0"+(date.getUTCDate())).slice(-2)+" "+
	("0"+(date.getUTCHours())).slice(-2)+":"+
	("0"+(date.getUTCMinutes())).slice(-2)+":"+
	("0"+(date.getUTCSeconds())).slice(-2)+"."+
	(bdtm1/1000000000.0).toString().substring(2));]]></scriptText>
          <pv trig="true">D1-I9-BCA0:SMTIMOBT00-GROUV</pv>
          <pv trig="true">D1-I9-BCA0:SMTIMOBT00-GTOAV</pv>
        </path>
      </scripts>
      <show_units>true</show_units>
      <text>######</text>
      <tooltip>$(pv_name)
$(pv_value)</tooltip>
      <transparent>false</transparent>
      <vertical_alignment>1</vertical_alignment>
      <visible>true</visible>
      <widget_type>Text Update</widget_type>
