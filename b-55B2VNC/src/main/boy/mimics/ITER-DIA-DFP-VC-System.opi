            <color name="IO Text Fg" red="0" green="0" blue="0" />
          </foreground_color>
          <height>44</height>
          <horizontal_alignment>0</horizontal_alignment>
          <name>Label Template_31</name>
          <rules>
            <rule name="Rule" prop_id="text" out_exp="false">
              <exp bool_exp="pv0==1||pv1==1||pv2==1">
                <value>OFF</value>
              </exp>
              <exp bool_exp="pv3==1||pv4==1||pv5==1">
                <value>NOT READY</value>
              </exp>
              <exp bool_exp="pv6==1">
                <value>READY</value>
              </exp>
              <exp bool_exp="pv7==1">
                <value>FAULT</value>
              </exp>
              <exp bool_exp="pv8==1">
                <value>LOCAL</value>
              </exp>
              <exp bool_exp="pv9==1">
                <value>ABORT</value>
              </exp>
              <exp bool_exp="pv10==1">
                <value>INITIALISING</value>
              </exp>
              <exp bool_exp="pv11==1">
                <value>INITIALISED</value>
              </exp>
              <exp bool_exp="pv12==1">
                <value>EXECUTING</value>
              </exp>
              <exp bool_exp="pv13==1">
                <value>POST CHECKS</value>
              </exp>
              <pv trig="true">D1-I2:SAFE-STATUS</pv>
              <pv trig="true">D1-I2:POWEROFF-STATUS</pv>
              <pv trig="true">D1-I2:ABSENT-STATUS</pv>
              <pv trig="true">D1-I2:POWERON-STATUS</pv>
              <pv trig="true">D1-I2:INCREADY-STATUS</pv>
              <pv trig="true">D1-I2:CONFIGURATION-STATUS</pv>
              <pv trig="true">D1-I2:55B2_READY-STATUS</pv>
              <pv trig="true">D1-I2:FAULT-STATUS</pv>
              <pv trig="true">D1-I2:LOCAL-STATUS</pv>
              <pv trig="true">D1-I2:ABORT-STATUS</pv>
              <pv trig="true">D1-I2:PREPARING-STATUS</pv>
              <pv trig="true">D1-I2:READY-STATUS</pv>
              <pv trig="true">D1-I2:RUNNING-STATUS</pv>
              <pv trig="true">D1-I2:POST_CHECK-STATUS</pv>
            </rule>
          </rules>
          <scale_options>
            <width_scalable>false</width_scalable>
            <height_scalable>false</height_scalable>
