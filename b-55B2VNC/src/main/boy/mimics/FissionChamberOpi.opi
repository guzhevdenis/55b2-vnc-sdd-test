        <foreground_color>
          <color name="IO InputPV Fg" red="0" green="0" blue="0" />
        </foreground_color>
        <height>41</height>
        <name>LED Template_7</name>
        <off_color>
          <color name="IO PV OFF" red="149" green="125" blue="71" />
        </off_color>
        <off_label>OFF</off_label>
        <on_color>
          <color name="IO Normal Level Alarm" red="0" green="255" blue="0" />
        </on_color>
        <on_label>ON</on_label>
        <pv_name>D1-I2-HWCF:B-8-InitializationDone</pv_name>
        <pv_value />
        <rules>
          <rule name="Alarm LED ON State Color" prop_id="on_color" out_exp="false">
            <exp bool_exp="pv0== 0">
              <value>
                <color name="IO Normal Level Alarm" red="0" green="255" blue="0" />
              </value>
            </exp>
            <exp bool_exp="pv0== 1">
              <value>
                <color name="IO Medium Level Alarm" red="255" green="255" blue="0" />
              </value>
            </exp>
            <exp bool_exp="pv0== 2">
              <value>
                <color name="IO High Level Alarm" red="250" green="12" blue="14" />
              </value>
            </exp>
            <exp bool_exp="pv0== 3">
              <value>
                <color name="IO Invalid Level Alarm" red="255" green="0" blue="255" />
              </value>
            </exp>
            <pv trig="true">$(pv_name).SEVR</pv>
          </rule>
          <rule name="Alarm LED OFF State Color" prop_id="off_color" out_exp="false">
            <exp bool_exp="pv0== 3">
              <value>
                <color name="IO Invalid Level Alarm" red="255" green="0" blue="255" />
              </value>
            </exp>
            <pv trig="true">$(pv_name).SEVR</pv>
          </rule>
        </rules>
        <scale_options>
          <width_scalable>false</width_scalable>
          <height_scalable>false</height_scalable>
          <keep_wh_ratio>false</keep_wh_ratio>
        </scale_options>
        <scripts />
        <show_boolean_label>false</show_boolean_label>
        <square_led>false</square_led>
        <tooltip>$(pv_name)
$(pv_value)</tooltip>
        <visible>true</visible>
        <widget_type>LED</widget_type>
