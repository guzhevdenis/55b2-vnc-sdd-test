        <action type="WRITE_PV">
            <pv_name>loc://$(DID)_FACEPLATE("")</pv_name>
            <value>faceplates/AnalogInProbe.opi PROBE_PV=$(pv_name) COMPONENT=$(name)</value>
            <timeout>10</timeout>
            <confirm_message/>
        </action>
    </actions>
          
    <alarm_pulsing>false</alarm_pulsing>
          
    <auto_size>false</auto_size>
          
    <backcolor_alarm_sensitive>true</backcolor_alarm_sensitive>
          
    <background_color>
                
        <color blue="235" green="235" name="IO InputPV Bg" red="235"/>
              
    </background_color>
          
    <border_alarm_sensitive>false</border_alarm_sensitive>
          
    <border_color>
                
        <color blue="178" green="178" name="IO Button" red="178"/>
              
    </border_color>
          
    <border_style>1</border_style>
          
    <border_width>1</border_width>
          
    <enabled>true</enabled>
          
    <font>
                
        <opifont.name fontName="DejaVu Sans Mono" height="10" pixels="false" style="0">IO Label</opifont.name>
              
    </font>
          
    <forecolor_alarm_sensitive>false</forecolor_alarm_sensitive>
          
    <foreground_color>
                
        <color blue="0" green="0" name="IO InputPV Fg" red="0"/>
              
    </foreground_color>
          
    <format_type>0</format_type>
          
    <height>38</height>
          
    <horizontal_alignment>1</horizontal_alignment>
          
    <name>D1-I2-SYSM-55B2-A0:PCF0004-SYSM-CBMQOVR</name>
          
    <precision>0</precision>
          
    <precision_from_pv>true</precision_from_pv>
          
    <pv_name>D1-I2-SYSM-55B2-A0:PCF0004-SYSM-CBMQOVR</pv_name>
          
    <pv_value/>
          
    <rotation_angle>0.0</rotation_angle>
          
    <rules/>
          
    <scale_options>
                
        <width_scalable>false</width_scalable>
                
        <height_scalable>false</height_scalable>
                
        <keep_wh_ratio>false</keep_wh_ratio>
              
    </scale_options>
          
    <scripts/>
          
    <show_units>true</show_units>
          
    <text/>
          
    <tooltip>$(pv_name) $(pv_value)</tooltip>
          
    <transparent>false</transparent>
          
    <vertical_alignment>1</vertical_alignment>
          
    <visible>true</visible>
          
    <widget_type>Text Update</widget_type>
          
    <width>600</width>
          
    <wrap_words>false</wrap_words>
          
      
    <x>300</x>
          
    <y>1</y>
        
</widget>


    
        
