<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.iter.codac.units</groupId>
  <artifactId>nds-sdn</artifactId>
  <packaging>codac</packaging>
  <version>1.1.0</version>
  <name>CODAC Core System NDS-SDN (v3) module</name>
  <description>NDS v3 Support for ITER SDN Publisher</description>
  <url>https://git.iter.org</url>

  <!-- project properties -->
  <properties>
    <unit.type>module</unit.type>
  </properties>

  <!-- parent pom.xml -->
  <parent>
    <groupId>org.iter.codac.units</groupId>
    <artifactId>maven-iter-settings</artifactId>
    <version>7.3.0</version>
  </parent>

  <!-- unit owner and developers -->
  <developers>
        <developer>
            <id>langer</id>
            <roles>
                <role>unit owner</role>
            </roles>
        </developer>

        <developer>
            <id>ruizm</id>
            <roles>
                <role>developer</role>
            </roles>
        </developer>

        <developer>
            <id>costav</id>
            <roles>
                <role>developer</role>
            </roles>
        </developer>
        
        <developer>
            <id>esquems</id>
            <roles>
                <role>developer</role>
            </roles>
        </developer>
  </developers>

  <!-- configuration of how the project is built -->
  <build>
    <!-- default phase is compile -->
    <defaultGoal>compile</defaultGoal>
    <!-- this command is executed if you just write 'mvn' -->
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-iter-plugin</artifactId>
        <extensions>true</extensions>
        <configuration>
          <packaging>

            <package name="lib" >
              <include type="library" name="nds3-sdn-publisher" />
              <requires codac="true">sdn</requires>
              <requires codac="true" buildonly="true">sdn-devel</requires>
              <requires codac="true">nds-core</requires>
              <requires codac="true" buildonly="true">nds-core-devel</requires>
            </package>

            <package develof="lib">
              <include type="file" source="main/c++/nds-sdn/include" target ="include"/>
              <requires codac="true">sdn-devel</requires>
              <requires codac="true">nds-core-devel</requires>
            </package>

            <package name="testdevices-nds-sdn">
              <include type="file" source="lib/libnds3-DeviceTesting.so" target="lib/"/>
              <requires codac="true">nds-sdn-lib</requires>
            </package>

            <package name="doc">
              <include type="doxygen" name="NDS-SDN" project="${project.name}" version="${project.version}" optimize="c">
                <filepattern>*.dox</filepattern>
                <filepattern>*.h</filepattern>
                <filepattern>*.cpp</filepattern>
                <outputformat>html</outputformat>
                <outputformat>pdf</outputformat>
                <input>main/c++/doc</input>
                <input>main/c++/nds-sdn/</input>
                <input>main/c++/nds-sdn/include</input>
		<imagepath>doc</imagepath>
                <properties>
                  <SORT_MEMBER_DOCS>NO</SORT_MEMBER_DOCS>
                  <HIDE_UNDOC_CLASSES>YES</HIDE_UNDOC_CLASSES>
                  <RECURSIVE>YES</RECURSIVE>
                  <EXTRACT_ALL>YES</EXTRACT_ALL>
                  <HIDE_UNDOC_MEMBERS>NO</HIDE_UNDOC_MEMBERS>
                  <EXTRACT_PRIVATE>YES</EXTRACT_PRIVATE>
                  <SOURCE_BROWSER>YES</SOURCE_BROWSER>
                  <DOT_FONTSIZE>10</DOT_FONTSIZE>
                  <CLASS_GRAPH>YES</CLASS_GRAPH>
                  <COLLABORATION_GRAPH>YES</COLLABORATION_GRAPH>
                  <GROUP_GRAPHS>YES</GROUP_GRAPHS>
                  <INCLUDE_GRAPH>YES</INCLUDE_GRAPH>
                  <INCLUDED_BY_GRAPH>YES</INCLUDED_BY_GRAPH>
                  <CALL_GRAPH>YES</CALL_GRAPH>
                  <CALLER_GRAPH>YES</CALLER_GRAPH>
                  <GRAPHICAL_HIERARCHY>YES</GRAPHICAL_HIERARCHY>
                  <DIRECTORY_GRAPH>YES</DIRECTORY_GRAPH>
                  <DOT_IMAGE_FORMAT>png</DOT_IMAGE_FORMAT>
                  <EXTRACT_STATIC>YES</EXTRACT_STATIC>
                  <GENERATE_TREEVIEW>YES</GENERATE_TREEVIEW>
                </properties>
              </include>
            </package>
                      
            <package name="epics-sample">
              <include type="source" source="src/main/epics/configure" 	target="examples/nds-sdn-epics/src/main/epics/configure" />
              <include type="source" source="src/main/epics/Makefile" 	target="examples/nds-sdn-epics/src/main/epics/Makefile" />
                  <include type="source" source="src/main/epics/iocBoot" 	target="examples/nds-sdn-epics/src/main/epics/iocBoot" />
                  <include type="source" source="src/main/epics/iocBoot/iocndssdn/envUserExample" 	target="examples/nds-sdn-epics/src/main/epics/iocBoot/iocndssdn/envUser" />
              <include type="source" source="src/main/epics/ndssdnApp" target="examples/nds-sdn-epics/src/main/epics/ndssdnApp" />
              <include type="source" source="src/main/resources" target="examples/nds-sdn-epics/src/main/resources" />
              <include type="source" source="src/main/scripts" target="examples/nds-sdn-epics/src/main/scripts" />
              <include type="source" source="epics-example-pom.xml" target="examples/nds-sdn-epics/pom.xml" />
            </package>
            
          </packaging>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
