|std::vector\<std::int16_t\>	|int16						|int16						|\>1 					|																	|\<attribute rank=" " name="int16Array_att" datatype="int16" multiplicity="512"/\>						|
|^								|^							|int32						|\>1 					|																	|\<attribute rank=" " name="int16Array_to_int32Array_att" datatype="int32" multiplicity="512"/\>		|
|^								|^							|int64						|\>1 					|																	|\<attribute rank=" " name="int16Array_to_int64Array_att" datatype="int64" multiplicity="512"/\>		|
|std::vector\<std::int32_t\>	|int32						|int32						|\>1 					|																	|\<attribute rank=" " name="int32Array_att" datatype="int32" multiplicity="512"/\>						|
