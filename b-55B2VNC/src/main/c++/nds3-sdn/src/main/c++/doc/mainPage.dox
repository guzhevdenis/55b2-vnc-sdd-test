|std::vector\<std::uint16_t\>	|uint16						|uint16						|\>1 					|																	|\<attribute rank=" " name="uint16Array_att" datatype="uint16" multiplicity="512"/\>					|
|^								|^							|uint32						|\>1 					|																	|\<attribute rank=" " name="uint16Array_to_uint32Array_att" datatype="uint32" multiplicity="512"/\>		|
|^								|^							|uint64						|\>1 					|																	|\<attribute rank=" " name="uint16Array_to_uint64Array_att" datatype="uint64" multiplicity="512"/\>		|
|std::vector\<std::uint32_t\>	|uint32						|uint32						|\>1 					|																	|\<attribute rank=" " name="uint32Array_att" datatype="uint32" multiplicity="512"/\>					|
|^								|^							|uint64						|\>1 					|																	|\<attribute rank=" " name="uint32Array_to_uint64Array_att" datatype="uint64" multiplicity="512"/\>		|
|std::vector\<float\>			|float						|float						|\>1 					|																	|\<attribute rank=" " name="floatArray_att" datatype="float" multiplicity="512"/\>						|
