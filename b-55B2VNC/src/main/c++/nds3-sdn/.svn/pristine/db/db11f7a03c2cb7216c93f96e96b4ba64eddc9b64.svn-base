< envPaths
< envSystem
< envUser

cd "${TOP}"

############################################################################
## Register all support components
############################################################################

dbLoadDatabase "dbd/ndssdn.dbd"
ndssdn_registerRecordDeviceDriver pdbbase

cd "${TOP}"
ndsLoadDriver("${TEST_LIB_PATH}/libnds3-DeviceTesting.so")
ndsCreateDevice(DeviceTesting, "Test-0","PV_CONF=../resources/test-nds-PVs.xml")
dbLoadTemplate("db/DeviceTesting.substitutions")

ndsLoadDriver("${TEST_LIB_PATH}/libnds3-sdn-publisher.so")
ndsCreateDevice(DeviceNDSSDNPUB, "SDN-0","INTERFACE=lo","TOPICNAME=test-topic-nds","PVS_CONFIG_PATH=../resources/input.xml")
dbLoadTemplate("db/DeviceNDSSDNPUB.substitutions")

############################################################################
## IOC Logging
############################################################################
iocLogInit
#iocLogPrefix "${STY} : "

############################################################################
## IOC initialization
############################################################################
cd "${TOP}/db"
iocInit

nds setLogLevelDebug SDN-0

