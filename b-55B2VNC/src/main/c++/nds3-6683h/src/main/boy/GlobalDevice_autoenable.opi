      <pv_value />
      <rules>
        <rule name="Alarm LED ON State Color" prop_id="on_color" out_exp="false">
          <exp bool_exp="pv0== 0">
            <value>
              <color name="IO Normal Level Alarm" red="0" green="255" blue="0" />
            </value>
          </exp>
          <exp bool_exp="pv0== 1">
            <value>
              <color name="IO Medium Level Alarm" red="255" green="255" blue="0" />
            </value>
          </exp>
          <exp bool_exp="pv0== 2">
            <value>
              <color name="IO High Level Alarm" red="250" green="12" blue="14" />
            </value>
          </exp>
          <exp bool_exp="pv0== 3">
            <value>
              <color name="IO Invalid Level Alarm" red="255" green="0" blue="255" />
            </value>
          </exp>
          <pv trig="true">$(pv_name).SEVR</pv>
        </rule>
        <rule name="Alarm LED OFF State Color" prop_id="off_color" out_exp="false">
          <exp bool_exp="pv0== 3">
            <value>
              <color name="IO Invalid Level Alarm" red="255" green="0" blue="255" />
            </value>
          </exp>
          <pv trig="true">$(pv_name).SEVR</pv>
        </rule>
      </rules>
