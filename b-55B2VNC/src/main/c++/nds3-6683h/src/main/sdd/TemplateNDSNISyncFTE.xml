<!--PVs for Future Time Event generation -->

	<variableTemplate name="HWCF:FTE-TERMINALSET">
		<direction>state</direction>
		<external>true</external>
		<presentOnScreens>true</presentOnScreens>
		<EPICSAttributes>
			<EPICSRecord
				name="$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(FTE_NAME)-TerminalSet"
				type="longout">
				<EPICSField name="DESC" value="Terminal to Set FTE" />
				<EPICSField name="DTYP" value="asynInt32" />
				<EPICSField name="OUT"
					value="@asyn($(BOARDTYPE)-$(BOARDTYPEIDX),0)$(FTE_NAME)-TerminalSet" />
				<EPICSField name="SCAN" value="Passive" />
			</EPICSRecord>
		</EPICSAttributes>
	</variableTemplate>
	
