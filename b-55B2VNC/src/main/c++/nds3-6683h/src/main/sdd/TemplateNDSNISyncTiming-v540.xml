	<macroGroup ID="USER">
		 <macro name="BOARDTYPE" description="Board type" value="NI-PXI-6683H-NDS"/>
     		<macro name="TIMING_NAME" description="Timing NDS Node Name" value="TIMING"/>
		
        </macroGroup>
	
