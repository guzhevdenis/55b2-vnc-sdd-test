	<variableTemplate name="HWCF:FW-HTIME">
		<direction>state</direction>
		<external>true</external>
		<presentOnScreens>true</presentOnScreens>
		<EPICSAttributes>
			<EPICSRecord
				name="$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TIMING_NAME)-HTime"
				type="waveform">
				<EPICSField name="DESC" value="Get Time in UTC format" />
				<EPICSField name="DTYP" value="asynInt8ArraIn" />
				<EPICSField name="FTVL" value="CHAR" />
				<EPICSField name="INP"
					value="@asyn($(BOARDTYPE)$(BOARDTYPEIDX),0)$(TIMING_NAME)-HTime" />
				<EPICSField name="SCAN" value="I/O Intr" />
				<EPICSField name="NELM" value="255" />
			</EPICSRecord>
		</EPICSAttributes>
	</variableTemplate>


