<!--State machine -->

	

	
	<variableTemplate name="HWCF:TIMING-STM-GLOBALSTATE">
		<direction>state</direction>
		<external>true</external>
		<raisesAlarm>true</raisesAlarm>
		<presentOnScreens>true</presentOnScreens>
		<EPICSAttributes>
			<EPICSRecord
				name="$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TIMING_NAME)-STM-getGlobalState"
				type="mbbi">
				<EPICSField name="DESC" value="" />
				<EPICSField name="DTYP" value="asynInt32" />
				<EPICSField name="INP"
				value="@asyn($(PREFIXBOARDTYPE)$(MODULEIDX),0)$(TIMING_NAME)-StateMachine-getGlobalState" />
				
				<EPICSField name="ZRVL" value="0" />		
				<EPICSField name="ONVL" value="1" />		
				<EPICSField name="TWVL" value="2" />		
				<EPICSField name="THVL" value="3" />		
				<EPICSField name="FRVL" value="4" />		
				<EPICSField name="FVVL" value="5" />		
				<EPICSField name="SXVL" value="6" />		
				<EPICSField name="SVVL" value="7" />		
				<EPICSField name="EIVL" value="8" />

				<EPICSField name="ZRST" value="UNKNOWN" />
				<EPICSField name="ONST" value="OFF" />
				<EPICSField name="TWST" value="SWITCHING_OFF" />
				<EPICSField name="THST" value="INITIALIZING" />
				<EPICSField name="FRST" value="ON" />
				<EPICSField name="FVST" value="STOPPING" />
				<EPICSField name="SXST" value="STARTING" />
				<EPICSField name="SVST" value="RUNNING" />
				<EPICSField name="EIST" value="FAULTS" /> 
				<EPICSField name="SCAN" value="Passive" />
				<EPICSField name="PINI" value="1" />				
			</EPICSRecord>
		</EPICSAttributes>
	</variableTemplate>
	
	<variableTemplate name="HWCF:TIMING-STM-STATE">
		<direction>state</direction>
		<external>true</external>
		<raisesAlarm>true</raisesAlarm>
		<presentOnScreens>true</presentOnScreens>
		<EPICSAttributes>
			<EPICSRecord
				name="$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TIMING_NAME)-STM-getState"
				type="mbbi">
				<EPICSField name="DESC" value="Get Local State" />
				<EPICSField name="DTYP" value="asynInt32" />
				<EPICSField name="INP"
					value="@asyn($(PREFIXBOARDTYPE)$(MODULEIDX),0)$(TIMING_NAME)-StateMachine-getState" />
				<EPICSField name="ZRVL" value="0" />		
				<EPICSField name="ONVL" value="1" />		
				<EPICSField name="TWVL" value="2" />		
				<EPICSField name="THVL" value="3" />		
				<EPICSField name="FRVL" value="4" />		
				<EPICSField name="FVVL" value="5" />		
				<EPICSField name="SXVL" value="6" />		
				<EPICSField name="SVVL" value="7" />
				<EPICSField name="EIVL" value="8" />
				<EPICSField name="ZRST" value="UNKNOWN" />
				<EPICSField name="ONST" value="OFF" />
				<EPICSField name="TWST" value="SWITCHING_OFF" />
				<EPICSField name="THST" value="INITIALIZING" />
				<EPICSField name="FRST" value="ON" />
				<EPICSField name="FVST" value="STOPPING" />
				<EPICSField name="SXST" value="STARTING" />
				<EPICSField name="SVST" value="RUNNING" />
				<EPICSField name="EIST" value="FAULT" />
				<EPICSField name="SCAN" value="I/O Intr" />
				<EPICSField name="PINI" value="1" />				
			</EPICSRecord>
		</EPICSAttributes>
	</variableTemplate>	

	<variableTemplate name="HWCF:TIMING-STM-SETSTATE">
		<direction>state</direction>
		<external>true</external>
		<raisesAlarm>true</raisesAlarm>
		<presentOnScreens>true</presentOnScreens>
		<EPICSAttributes>
			<EPICSRecord
				name="$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TIMING_NAME)-STM-setState"
				type="mbbo">
				<EPICSField name="DESC" value="Set Local State" />
				<EPICSField name="DTYP" value="asynInt32" />
				<EPICSField name="OUT"
					value="@asyn($(PREFIXBOARDTYPE)$(MODULEIDX),0)$(TIMING_NAME)-StateMachine-setState" />
				<EPICSField name="ZRVL" value="0" />		
				<EPICSField name="ONVL" value="1" />		
				<EPICSField name="TWVL" value="2" />		
				<EPICSField name="THVL" value="3" />		
				<EPICSField name="FRVL" value="4" />		
				<EPICSField name="FVVL" value="5" />		
				<EPICSField name="SXVL" value="6" />		
				<EPICSField name="SVVL" value="7" />
				<EPICSField name="EIVL" value="8" />
				<EPICSField name="ZRST" value="UNKNOWN" />
				<EPICSField name="ONST" value="OFF" />
				<EPICSField name="TWST" value="SWITCHING_OFF" />
				<EPICSField name="THST" value="INITIALIZING" />
				<EPICSField name="FRST" value="ON" />
				<EPICSField name="FVST" value="STOPPING" />
				<EPICSField name="SXST" value="STARTING" />
				<EPICSField name="SVST" value="RUNNING" />
				<EPICSField name="EIST" value="FAULTS" />
				<EPICSField name="SCAN" value="Passive" />
								
			</EPICSRecord>
		</EPICSAttributes>
	</variableTemplate>

	<variableTemplate name="HWCF:TIMING-SYNCSTATUS">
		<direction>state</direction>
		<external>true</external>
		<raisesAlarm>true</raisesAlarm>
		<presentOnScreens>true</presentOnScreens>
		<EPICSAttributes>
			<EPICSRecord
				name="$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TIMING_NAME)-SyncStatus"
				type="mbbi">
				<EPICSField name="DESC" value="Synchronization status" />
				<EPICSField name="DTYP" value="asynInt32" />
				<EPICSField name="INP"
				value="@asyn($(PREFIXBOARDTYPE)$(MODULEIDX),0)$(TIMING_NAME)-SyncStatus" />
				
				<EPICSField name="ZRVL" value="0" />		
				<EPICSField name="ONVL" value="1" />		
				<EPICSField name="TWVL" value="2" />		
				<EPICSField name="THVL" value="3" />		
				

				<EPICSField name="ZRST" value="NOT SYNCED" />
				<EPICSField name="ONST" value="SYNCING" />
				<EPICSField name="TWST" value="SYNCED" />
				<EPICSField name="THST" value="LOST SYNC" />
				
								
			</EPICSRecord>
		</EPICSAttributes>
	</variableTemplate>

	
	<variableTemplate name="HWCF:FW-Time">
		<direction>state</direction>
		<external>true</external>
		<presentOnScreens>true</presentOnScreens>
		<EPICSAttributes>
			<EPICSRecord
				name="$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TIMING_NAME)-Time"
				type="waveform">
				<EPICSField name="DESC" value="Get Time t" />
				<EPICSField name="DTYP" value="asynInt32ArraIn" />
				<EPICSField name="FTVL" value="LONG" />
				<EPICSField name="INP"
					value="@asyn($(BOARDTYPE)$(BOARDTYPEIDX),0)$(TIMING_NAME)-Time" />
				<EPICSField name="SCAN" value="Passive" />
				<EPICSField name="NELM" value="2" />
			</EPICSRecord>
		</EPICSAttributes>
	</variableTemplate>


	<variableTemplate name="HWCF:FW-TimeSEC">
		<direction>state</direction>
		<external>true</external>
		<presentOnScreens>true</presentOnScreens>
		<EPICSAttributes>
			<EPICSRecord
				name="$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TIMING_NAME)-TimeSec"
				type="subArray">
				<EPICSField name="DESC" value="Get Time in Seconds" />
				
				<EPICSField name="FTVL" value="LONG" />
				<EPICSField name="INP"
					value="@asyn($(BOARDTYPE)$(BOARDTYPEIDX),0)$(TIMING_NAME)-Time CP MS" />
				<EPICSField name="EGU" value="s" />
				<EPICSField name="MALM" value="2" />
				<EPICSField name="INDX" value="0" />
			</EPICSRecord>
		</EPICSAttributes>
	</variableTemplate>

