				name="$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TIMING_NAME)-SecsLastSync"
				type="longin">
				<EPICSField name="DESC" value="Seconds since last synchronization" />
				<EPICSField name="DTYP" value="asynInt32" />
				<EPICSField name="INP"
					value="@asyn($(BOARDTYPE)$(BOARDTYPEIDX),0)$(TIMING_NAME)-SecsLastSync" />
