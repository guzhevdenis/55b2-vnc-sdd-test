record(mbbi, "$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(FIRMWARE_NAME)-Status") {
    field(DESC, "$(FIRMWARE_NAME)ware status")
    field(DTYP, "asynInt32")
    field(SCAN, "I/O Intr")
    field(INP, "@asyn($(BOARDTYPE)-$(BOARDTYPEIDX), 0)$(FIRMWARE_NAME)-Status")
    field(ZRVL, 0)
    field(ZRST, "OK")
    field(ZRSV, "NO_ALARM")
    field(ONVL, 1)
    field(ONST, "INITIALIZING")
    field(TWVL, 2)
    field(TWST, "RESETTING")
    field(THVL, 3)
    field(THST, "HW_ERROR")
    field(THSV, "MAJOR")
    field(FRVL, 4)
    field(FRST, "UNAVAILABLE")
    field(FRSV, "MAJOR")
    field(FVVL, 5)
    field(FVST, "STATIC_CONF_ERROR")
    field(FVSV, "MAJOR")
    field(SXVL, 6)
    field(SXST, "DYNAMIC_CONF_ERROR")
    field(SXSV, "MAJOR")
    field(SVVL, 7)
    field(SVST, "RESERVED")
    field(EIVL, 8)
    field(EIST, "HW_FIFO_OVERFLOW")
    field(EISV, "MINOR")
    field(NIVL, 9)
    field(NIST, "HW_FPGA_NOT_READY")
    field(NISV, "MINOR")
    field(TEVL, 10)
    field(TEST, "HW_CLK_NOT_LOCKED")
    field(TESV, "MINOR")
    field(ELVL, 11)
    field(ELST, "DRV_BUFFER_OVERFLOW")
    field(ELSV, "MAJOR")
}


