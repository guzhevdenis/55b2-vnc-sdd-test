	<!--Maximum number of FTEs that can be scheduled -->
	<variableTemplate name="HWCF:TERMINAL-FTE-MAXIMUM">
		<direction>state</direction>
		<external>true</external>
		<presentOnScreens>true</presentOnScreens>
		<EPICSAttributes>
			<EPICSRecord name="$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TERMINAL_NAME)-FTE-Maximum"
				type="longin">
				<EPICSField name="DESC" value="Maximum FTEs" />
				<EPICSField name="DTYP" value="asynInt32" />
				<EPICSField name="INP" value="@asyn($(BOARDTYPE)-$(BOARDTYPEIDX),0)$(TERMINAL_NAME)-FTE-Maximum" />
				<EPICSField name="SCAN" value="I/O Intr" />
			</EPICSRecord>
		</EPICSAttributes>
	</variableTemplate>
	<!--State machine -->
	<variableTemplate name="HWCF:TERMINAL-STM-STATE">
		<direction>state</direction>
		<external>true</external>
		<raisesAlarm>true</raisesAlarm>
		<presentOnScreens>true</presentOnScreens>
		<EPICSAttributes>
			<EPICSRecord name="$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TERMINAL_NAME)-STM-getState"
				type="mbbi">
				<EPICSField name="DESC" value="Get Local State" />
				<EPICSField name="DTYP" value="asynInt32" />
				<EPICSField name="INP"
					value="@asyn($(BOARDTYPE)-$(BOARDTYPEIDX),0)$(TERMINAL_NAME)-StateMachine-getState" />
				<EPICSField name="ZRVL" value="0" />
				<EPICSField name="ONVL" value="1" />
				<EPICSField name="TWVL" value="2" />
				<EPICSField name="THVL" value="3" />
				<EPICSField name="FRVL" value="4" />
				<EPICSField name="FVVL" value="5" />
				<EPICSField name="SXVL" value="6" />
				<EPICSField name="SVVL" value="7" />
				<EPICSField name="EIVL" value="8" />
				<EPICSField name="ZRST" value="UNKNOWN" />
				<EPICSField name="ONST" value="OFF" />
				<EPICSField name="TWST" value="SWITCHING_OFF" />
				<EPICSField name="THST" value="INITIALIZING" />
				<EPICSField name="FRST" value="ON" />
				<EPICSField name="FVST" value="STOPPING" />
				<EPICSField name="SXST" value="STARTING" />
				<EPICSField name="SVST" value="RUNNING" />
				<EPICSField name="EIST" value="FAULT" />
				<EPICSField name="ZRSV" value="MINOR" />
				<EPICSField name="EISV" value="MAJOR" />
				<EPICSField name="SCAN" value="I/O Intr" />
				<EPICSField name="PINI" value="1" />
			</EPICSRecord>
		</EPICSAttributes>
	</variableTemplate>
	<variableTemplate name="HWCF:TERMINAL-STM-SETSTATE">
		<direction>configuration</direction>
		<external>true</external>
		<raisesAlarm>true</raisesAlarm>
		<presentOnScreens>true</presentOnScreens>
		<EPICSAttributes>
			<EPICSRecord name="$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TERMINAL_NAME)-STM-setState"
				type="mbbo">
				<EPICSField name="DESC" value="Set Local State" />
				<EPICSField name="DTYP" value="asynInt32" />
				<EPICSField name="OUT"
					value="@asyn($(BOARDTYPE)-$(BOARDTYPEIDX),0)$(TERMINAL_NAME)-StateMachine-setState" />
				<EPICSField name="ONVL" value="1" />
				<EPICSField name="FRVL" value="4" />
				<EPICSField name="SVVL" value="7" />
				<EPICSField name="ONST" value="OFF" />
				<EPICSField name="FRST" value="ON" />
				<EPICSField name="SVST" value="RUNNING" />
				<EPICSField name="SCAN" value="Passive" />
			</EPICSRecord>
		</EPICSAttributes>
	</variableTemplate>
	<macroGroup ID="USER">
		<macro name="BOARDTYPE" description="Board type" value="6683H" />
		<macro name="TERMINAL_NAME" description="Future Time Event and Timestampin NDS Node Name" value="TR" />
	</macroGroup>
</template>