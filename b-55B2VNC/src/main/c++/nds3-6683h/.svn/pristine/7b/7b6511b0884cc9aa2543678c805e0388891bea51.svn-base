	<variableTemplate name="HWCF:FW-DRIVER">
		<direction>state</direction>
		<external>true</external>
		<presentOnScreens>true</presentOnScreens>
		<EPICSAttributes>
			<EPICSRecord
				name="$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(FIRMWARE_NAME)-DriverVersion"
				type="waveform">
				<EPICSField name="DESC" value="Driver Version" />
				<EPICSField name="DTYP" value="asynInt8ArrayIn" />
				<EPICSField name="FTVL" value="CHAR" />
				<EPICSField name="SCAN" value="I/O Intr" />
				<EPICSField name="NELM" value="255" />
				<EPICSField name="INP"	value="@asyn($(BOARDTYPE)-$(BOARDTYPEIDX),0)$(FIRMWARE_NAME)-DriverVersion" />
			</EPICSRecord>
		</EPICSAttributes>
	</variableTemplate>

