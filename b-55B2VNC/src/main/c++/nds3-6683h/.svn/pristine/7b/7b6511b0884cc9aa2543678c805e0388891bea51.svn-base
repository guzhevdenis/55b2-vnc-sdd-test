				<EPICSField name="DTYP" value="asynInt8ArrayIn" />
				<EPICSField name="FTVL" value="CHAR" />
				<EPICSField name="INP"
					value="@asyn($(BOARDTYPE)-$(BOARDTYPEIDX),0)$(FIRMWARE_NAME)-Version" />
