	<variableTemplate name="HWCF:FW-HWRevision">
		<direction>state</direction>
		<external>true</external>
		<presentOnScreens>true</presentOnScreens>
		<EPICSAttributes>
			<EPICSRecord
				name="$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(FIRMWARE_NAME)-HWRevision"
				type="waveform">
				<EPICSField name="DESC" value="Hardware revision" />
				<EPICSField name="DTYP" value="asynInt8ArrayIn" />
				<EPICSField name="FTVL" value="CHAR" />
				<EPICSField name="NELM" value="255" />
				<EPICSField name="SCAN" value="I/O Intr" />
				<EPICSField name="INP"	value="@asyn($(BOARDTYPE)-$(BOARDTYPEIDX),0)$(FIRMWARE_NAME)-HWRevision" />
			</EPICSRecord>
		</EPICSAttributes>
	</variableTemplate> 
	
	<variableTemplate name="HWCF:FW-SerialNumber">
		<direction>state</direction>
		<external>true</external>
		<presentOnScreens>true</presentOnScreens>
		<EPICSAttributes>
			<EPICSRecord
				name="$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(FIRMWARE_NAME)-SerialNumber"
				type="waveform">
				<EPICSField name="DESC" value="Serial Number" />
				<EPICSField name="DTYP" value="asynInt8ArrayIn" />
				<EPICSField name="FTVL" value="CHAR" />
				<EPICSField name="NELM" value="255" />
				<EPICSField name="SCAN" value="I/O Intr" />
				<EPICSField name="INP"	value="@asyn($(BOARDTYPE)-$(BOARDTYPEIDX),0)$(FIRMWARE_NAME)-Model" />
			</EPICSRecord>
		</EPICSAttributes>
	</variableTemplate>

	<variableTemplate name="HWCF:FW-Model">
		<direction>state</direction>
		<external>true</external>
		<presentOnScreens>true</presentOnScreens>
		<EPICSAttributes>
			<EPICSRecord
				name="$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(FIRMWARE_NAME)-Model"
				type="waveform">
				<EPICSField name="DESC" value="Device Model" />
				<EPICSField name="DTYP" value="asynInt8ArrayIn" />
				<EPICSField name="FTVL" value="CHAR" />
				<EPICSField name="NELM" value="255" />
				<EPICSField name="SCAN" value="I/O Intr" />
				<EPICSField name="INP"	value="@asyn($(BOARDTYPE)-$(BOARDTYPEIDX),0)$(FIRMWARE_NAME)-Model" />
			</EPICSRecord>
		</EPICSAttributes>
	</variableTemplate>
	
	<variableTemplate name="HWCF:FW-Type">
		<direction>state</direction>
		<external>true</external>
		<presentOnScreens>true</presentOnScreens>
		<EPICSAttributes>
			<EPICSRecord
				name="$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(FIRMWARE_NAME)-Type"
				type="waveform">
				<EPICSField name="DESC" value="Device Type" />
				<EPICSField name="DTYP" value="asynInt8ArrayIn" />
				<EPICSField name="FTVL" value="CHAR" />
				<EPICSField name="NELM" value="255" />
				<EPICSField name="SCAN" value="I/O Intr" />
				<EPICSField name="INP"	value="@asyn($(BOARDTYPE)-$(BOARDTYPEIDX),0)$(FIRMWARE_NAME)-Type" />
			</EPICSRecord>
		</EPICSAttributes>
	</variableTemplate>
	
