    field(ZNAM, "DISABLE")
    field(ONAM, "ENABLE")
}

record(mbbo, "$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TERMINAL_NAME)-FTE-ModeSet") {
