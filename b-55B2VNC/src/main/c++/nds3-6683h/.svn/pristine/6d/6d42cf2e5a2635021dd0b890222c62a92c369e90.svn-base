#Multiple functionality PVs, search for:
#STATEMACHINE
#TIMESTAMPS
#FTE GENERATION

record(bo, "$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TERMINAL_NAME)-TS-DecimationType") {
    field(DESC, "Set decimation SW or HW")
    field(DTYP, "asynInt32")
    field(SCAN, "Passive")
    field(OUT, "@asyn($(BOARDTYPE)-$(BOARDTYPEIDX),0)$(TERMINAL_NAME)-TS-DecimationType")
    field(ZNAM, "SW")
    field(ONAM, "HW")
}

#TIMESTAMPS

record(longout, "$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TERMINAL_NAME)-TS-Decimation") {
    field(DESC, "Decimation")
    field(DTYP, "asynInt32")
    field(SCAN, "Passive")
    field(OUT, "@asyn($(BOARDTYPE)-$(BOARDTYPEIDX),0)$(TERMINAL_NAME)-TS-Decimation")
}

record(mbbo, "$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TERMINAL_NAME)-TS-Edge") {
    field(DESC, "Set timestamp edge detection")
    field(DTYP, "asynInt32")
    field(SCAN, "Passive")
    field(OUT, "@asyn($(BOARDTYPE)-$(BOARDTYPEIDX),0)$(TERMINAL_NAME)-TS-Edge")
    field(ZRVL, 0)
    field(ZRST, "RISING")
    field(ONVL, 1)
    field(ONST, "FALLING")
    field(TWVL, 2)
    field(TWST, "ANY")
    field(PINI, 1)
}

record(mbbi, "$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TERMINAL_NAME)-TS-Edge_RBV") {
    field(DESC, "Get timestamping edge detection")
    field(DTYP, "asynInt32")
    field(SCAN, "I/O Intr")
    field(INP, "@asyn($(BOARDTYPE)-$(BOARDTYPEIDX),0)$(TERMINAL_NAME)-TS-Edge_RBV")
    field(UNSV, "INVALID")
    field(ZRVL, 0)
    field(ZRST, "RISING")
    field(ONVL, 1)
    field(ONST, "FALLING")
    field(TWVL, 2)
    field(TWST, "ANY")
    field(PINI, 1)
}

record(longin, "$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TERMINAL_NAME)-TS-MaxTimestamps") {
    field(DESC, "Maximum number of timestamps (FIFO size)")
    field(DTYP, "asynInt32")
    field(SCAN, "I/O Intr")
    field(INP, "@asyn($(BOARDTYPE)-$(BOARDTYPEIDX),0)$(TERMINAL_NAME)-TS-MaxTimestamps")
}

record(longin, "$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TERMINAL_NAME)-TS-Overflow") {
    field(DESC, "Get timestamps queue overflow status")
    field(DTYP, "asynInt32")
    field(SCAN, "I/O Intr")
    field(INP, "@asyn($(BOARDTYPE)-$(BOARDTYPEIDX),0)$(TERMINAL_NAME)-TS-Overflow")
 
}

record(waveform, "$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TERMINAL_NAME)-TS-Timestamps") {
    field(DESC, "Timestamp (sec,ns), ID, Edge")
    field(DTYP, "asynInt32ArrayIn")
    field(FTVL, "LONG")
    field(NELM, 4)
    field(SCAN, "I/O Intr")
    field(INP, "@asyn($(BOARDTYPE)-$(BOARDTYPEIDX),0)$(TERMINAL_NAME)-TS-Timestamps")
    field(TSE, -2)
}


record(subArray, "$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TERMINAL_NAME)-TS-TimestampsSec" ) {
	field(DESC, "Timestamp Seconds")
	field(FTVL, "LONG")
	field(INP,  "$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TERMINAL_NAME)-TS-Timestamps CP MS")
	field(EGU,  "s")
	field(MALM, "4")
	field(INDX, "0")
}

record(subArray, "$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TERMINAL_NAME)-TS-TimestampsNano" ) {
	field(DESC, "Timestamp Nanoseconds")
	field(FTVL, "LONG")
	field(INP,  "$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TERMINAL_NAME)-TS-Timestamps CP MS")
	field(EGU,  "ns")
	field(MALM, "4")
	field(INDX, "1")
}


record(subArray, "$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TERMINAL_NAME)-TS-TimestampsID" ) {
	field(DESC, "Timestamp ID")
	field(FTVL, "LONG")
	field(INP,  "$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TERMINAL_NAME)-TS-Timestamps CP MS")
	field(MALM, "4")
	field(INDX, "2")
}

record(subArray, "$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TERMINAL_NAME)-TS-TimestampsIsRising" ) {
	field(DESC, "Timestamp Rising")
	field(FTVL, "LONG")
	field(INP,  "$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TERMINAL_NAME)-TS-Timestamps CP MS")
	field(MALM, "4")
	field(INDX, "3")
}

#FTE GENERATION

#PVs for Future Time Event generation 

record(bo, "$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TERMINAL_NAME)-FTE-Enable") {
    field(DESC, "Enable/Disable FTE. Terminal direction.")
    field(DTYP, "asynInt32")
    field(SCAN, "Passive")
    field(OUT, "@asyn($(BOARDTYPE)-$(BOARDTYPEIDX),0)$(TERMINAL_NAME)-FTE-Enable")
    field(ZNAM, "DISABLE")
    field(ONAM, "ENABLE")
}

