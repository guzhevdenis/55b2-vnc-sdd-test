<template name="nds-nisync-Timestamping" description="template for Timestamping"
        version="600" required="true" usesSubstitutionFiles="true"
	userCanInstanciate="true" xmlns="http://www.iter.org/CODAC/PlantSystemIandC/2014-2"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.iter.org/CODAC/PlantSystemIandC/2014-2 ../xsd/PlantSystemIandC.xsd">
	<applicableToControlUnit>PCF</applicableToControlUnit>
	<applicableToIOBoard>NI PXI-6683H-NDS</applicableToIOBoard>
	<location>nisync_Timestamping.template</location>
	<EPICSDBDName>nds3-epics.dbd</EPICSDBDName>
	<EPICSLibraryName>nds3-epics</EPICSLibraryName>

<!-- -->

	<variableTemplate name="HWCF:TIMESTAMPING-CLEAROVERFLOW">
		<direction>state</direction>
		<external>true</external>
		<presentOnScreens>true</presentOnScreens>
		<EPICSAttributes>
			<EPICSRecord
				name="$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TIMESTAMPING_NAME)-ClearOverflow"
				type="longout">
				<EPICSField name="DESC" value="Clear timetamp overflow error" />
				<EPICSField name="DTYP" value="asynInt32" />
				<EPICSField name="OUT"
					value="@asyn($(BOARDTYPE)-$(BOARDTYPEIDX),0)$(TIMESTAMPING_NAME)-ClearOverflow" />
				<EPICSField name="SCAN" value="Passive" />
			</EPICSRecord>
		</EPICSAttributes>
	</variableTemplate>
	
	<!--<variableTemplate name="HWCF:TIMESTAMPING-Decimation">
		<direction>state</direction>
		<external>true</external>
		<presentOnScreens>true</presentOnScreens>
		<EPICSAttributes>
			<EPICSRecord
				name="$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TIMESTAMPING_NAME)-Decimation"
				type="longout">
				<EPICSField name="DESC" value="Decimation" />
				<EPICSField name="DTYP" value="asynInt32" />
				<EPICSField name="OUT"
					value="@asyn($(BOARDTYPE)$(BOARDTYPEIDX),0)$(TIMESTAMPING_NAME)-Decimation" />
				<EPICSField name="SCAN" value="Passive" />
			</EPICSRecord>
		</EPICSAttributes>
	</variableTemplate> -->

	<variableTemplate name="HWCF:TIMESTAMPING-EDGE">
		<direction>state</direction>
		<external>true</external>
		<presentOnScreens>true</presentOnScreens>
		<EPICSAttributes>
			<EPICSRecord
				name="$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TIMESTAMPING_NAME)-Edge"
				type="mbbo">
				<EPICSField name="DESC" value="Set timestamp edge detection" />
				<EPICSField name="DTYP" value="asynInt32" />
				<EPICSField name="OUT"
					value="@asyn($(BOARDTYPE)-$(BOARDTYPEIDX),0)$(TIMESTAMPING_NAME)-Edge" />
				<EPICSField name="SCAN" value="Passive" />
				
				
				<EPICSField name="ZRVL" value="0" />		
				<EPICSField name="ONVL" value="1" />		
				<EPICSField name="TWVL" value="2" />		
				<EPICSField name="ZRST" value="RISING" />
				<EPICSField name="ONST" value="FALLING" />
				<EPICSField name="TWST" value="ANY" />
				
			</EPICSRecord>
		</EPICSAttributes>
	</variableTemplate>

	<variableTemplate name="HWCF:TIMESTAMPING-EDGERBV">
		<direction>state</direction>
		<external>true</external>
		<presentOnScreens>true</presentOnScreens>
		<EPICSAttributes>
			<EPICSRecord
				name="$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TIMESTAMPING_NAME)-Edge_RBV"
				type="mbbi">
				<EPICSField name="DESC" value="Set timestamp edge detection" />
				<EPICSField name="DTYP" value="asynInt32" />
				<EPICSField name="INP"
					value="@asyn($(BOARDTYPE)-$(BOARDTYPEIDX),0)$(TIMESTAMPING_NAME)-Edge_RBV" />
				<EPICSField name="SCAN" value="Passive" />
				
				
				<EPICSField name="ZRVL" value="0" />		
				<EPICSField name="ONVL" value="1" />		
				<EPICSField name="TWVL" value="2" />		
				<EPICSField name="ZRST" value="RISING" />
				<EPICSField name="ONST" value="FALLING" />
				<EPICSField name="TWST" value="ANY" />
				
			</EPICSRecord>
		</EPICSAttributes>
	</variableTemplate>




	<variableTemplate name="HWCF:TIMESTAMPING-ENABLE">
		<direction>state</direction>
		<external>true</external>
		<presentOnScreens>true</presentOnScreens>
		<EPICSAttributes>
			<EPICSRecord
				name="$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TIMESTAMPING_NAME)-Enable"
				type="mbbo">
				<EPICSField name="DESC" value="Enable/Disable Timetamping" />
				<EPICSField name="DTYP" value="asynInt32" />
				<EPICSField name="OUT"
					value="@asyn($(BOARDTYPE)-$(BOARDTYPEIDX),0)$(TIMESTAMPING_NAME)-Enable" />
				<EPICSField name="SCAN" value="Passive" />
				
				
				<EPICSField name="ZRVL" value="0" />		
				<EPICSField name="ONVL" value="1" />		
						
				<EPICSField name="ZRST" value="RISING" />
				<EPICSField name="ONST" value="FALLING" />
				
				
			</EPICSRecord>
		</EPICSAttributes>
	</variableTemplate>

	<variableTemplate name="HWCF:TIMESTAMPING-ENABLEERBV">
		<direction>state</direction>
		<external>true</external>
		<presentOnScreens>true</presentOnScreens>
		<EPICSAttributes>
			<EPICSRecord
				name="$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TIMESTAMPING_NAME)-Enable_RBV"
				type="mbbi">
				<EPICSField name="DESC" value="Timestamping status: enable/Disable" />
				<EPICSField name="DTYP" value="asynInt32" />
				<EPICSField name="INP"
					value="@asyn($(BOARDTYPE)-$(BOARDTYPEIDX),0)$(TIMESTAMPING_NAME)-Enable_RBV" />
				<EPICSField name="SCAN" value="Passive" />
				
				
				<EPICSField name="ZRVL" value="0" />		
				<EPICSField name="ONVL" value="1" />		
				<EPICSField name="TWVL" value="2" />		
				<EPICSField name="ZRST" value="RISING" />
				<EPICSField name="ONST" value="FALLING" />
				<EPICSField name="TWST" value="ANY" />
				
			</EPICSRecord>
		</EPICSAttributes>
	</variableTemplate>




	<variableTemplate name="HWCF:TIMESTAMPING-MAXTIMESTAMPS">
		<direction>state</direction>
		<external>true</external>
		<presentOnScreens>true</presentOnScreens>
		<EPICSAttributes>
			<EPICSRecord
				name="$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TIMESTAMPING_NAME)-MaxTimestamps"
				type="longin">
				<EPICSField name="DESC" value="Maximum number of timetamps (FIFO size)" />
				<EPICSField name="DTYP" value="asynInt32" />
				<EPICSField name="INP"
					value="@asyn($(BOARDTYPE)-$(BOARDTYPEIDX),0)$(TIMESTAMPING_NAME)-MaxTimestamps" />
				<EPICSField name="SCAN" value="I/O Intr" />
			</EPICSRecord>
		</EPICSAttributes>
	</variableTemplate>



	

<!--State machine -->

	

	
	<variableTemplate name="HWCF:TIMESTAMPING-STM-GLOBALSTATE">
		<direction>state</direction>
		<external>true</external>
		<raisesAlarm>true</raisesAlarm>
		<presentOnScreens>true</presentOnScreens>
		<EPICSAttributes>
			<EPICSRecord
				name="$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TIMESTAMPING_NAME)-STM-getGlobalState"
				type="mbbi">
				<EPICSField name="DESC" value="" />
				<EPICSField name="DTYP" value="asynInt32" />
				<EPICSField name="INP"
				value="@asyn($(BOARDTYPE)-$(BOARDTYPEIDX),0)$(TIMESTAMPING_NAME)-StateMachine-getGlobalState" />
				
				<EPICSField name="ZRVL" value="0" />		
				<EPICSField name="ONVL" value="1" />		
				<EPICSField name="TWVL" value="2" />		
				<EPICSField name="THVL" value="3" />		
				<EPICSField name="FRVL" value="4" />		
				<EPICSField name="FVVL" value="5" />		
				<EPICSField name="SXVL" value="6" />		
				<EPICSField name="SVVL" value="7" />		
				<EPICSField name="EIVL" value="8" />

				<EPICSField name="ZRST" value="UNKNOWN" />
				<EPICSField name="ONST" value="OFF" />
				<EPICSField name="TWST" value="SWITCHING_OFF" />
				<EPICSField name="THST" value="INITIALIZING" />
				<EPICSField name="FRST" value="ON" />
				<EPICSField name="FVST" value="STOPPING" />
				<EPICSField name="SXST" value="STARTING" />
				<EPICSField name="SVST" value="RUNNING" />
				<EPICSField name="EIST" value="FAULTS" /> 
				<EPICSField name="SCAN" value="Passive" />
				<EPICSField name="PINI" value="1" />				
			</EPICSRecord>
		</EPICSAttributes>
	</variableTemplate>
	
	<variableTemplate name="HWCF:TIMESTAMPING-STM-STATE">
		<direction>state</direction>
		<external>true</external>
		<raisesAlarm>true</raisesAlarm>
		<presentOnScreens>true</presentOnScreens>
		<EPICSAttributes>
			<EPICSRecord
				name="$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TIMESTAMPING_NAME)-STM-getState"
				type="mbbi">
				<EPICSField name="DESC" value="Get Local State" />
				<EPICSField name="DTYP" value="asynInt32" />
				<EPICSField name="INP"
					value="@asyn($(BOARDTYPE)-$(BOARDTYPEIDX),0)$(TIMESTAMPING_NAME)-StateMachine-getState" />
				<EPICSField name="ZRVL" value="0" />		
				<EPICSField name="ONVL" value="1" />		
				<EPICSField name="TWVL" value="2" />		
				<EPICSField name="THVL" value="3" />		
				<EPICSField name="FRVL" value="4" />		
				<EPICSField name="FVVL" value="5" />		
				<EPICSField name="SXVL" value="6" />		
				<EPICSField name="SVVL" value="7" />
				<EPICSField name="EIVL" value="8" />
				<EPICSField name="ZRST" value="UNKNOWN" />
				<EPICSField name="ONST" value="OFF" />
				<EPICSField name="TWST" value="SWITCHING_OFF" />
				<EPICSField name="THST" value="INITIALIZING" />
				<EPICSField name="FRST" value="ON" />
				<EPICSField name="FVST" value="STOPPING" />
				<EPICSField name="SXST" value="STARTING" />
				<EPICSField name="SVST" value="RUNNING" />
				<EPICSField name="EIST" value="FAULT" />
				<EPICSField name="SCAN" value="I/O Intr" />
				<EPICSField name="PINI" value="1" />				
			</EPICSRecord>
		</EPICSAttributes>
	</variableTemplate>	

	<variableTemplate name="HWCF:TIMESTAMPING-STM-SETSTATE">
		<direction>state</direction>
		<external>true</external>
		<raisesAlarm>true</raisesAlarm>
		<presentOnScreens>true</presentOnScreens>
		<EPICSAttributes>
			<EPICSRecord
				name="$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(TIMESTAMPING_NAME)-STM-setState"
				type="mbbi">
				<EPICSField name="DESC" value="Set Local State" />
				<EPICSField name="DTYP" value="asynInt32" />
				<EPICSField name="INP"
					value="@asyn($(BOARDTYPE)-$(BOARDTYPEIDX),0)$(TIMESTAMPING_NAME)-StateMachine-setState" />
				<EPICSField name="ZRVL" value="0" />		
				<EPICSField name="ONVL" value="1" />		
				<EPICSField name="TWVL" value="2" />		
				<EPICSField name="THVL" value="3" />		
				<EPICSField name="FRVL" value="4" />		
				<EPICSField name="FVVL" value="5" />		
				<EPICSField name="SXVL" value="6" />		
				<EPICSField name="SVVL" value="7" />
				<EPICSField name="EIVL" value="8" />
				<EPICSField name="ZRST" value="UNKNOWN" />
				<EPICSField name="ONST" value="OFF" />
				<EPICSField name="TWST" value="SWITCHING_OFF" />
				<EPICSField name="THST" value="INITIALIZING" />
				<EPICSField name="FRST" value="ON" />
				<EPICSField name="FVST" value="STOPPING" />
				<EPICSField name="SXST" value="STARTING" />
				<EPICSField name="SVST" value="RUNNING" />
				<EPICSField name="EIST" value="FAULTS" />
				<EPICSField name="SCAN" value="Passive" />
								
			</EPICSRecord>
		</EPICSAttributes>
	</variableTemplate>

	<macroGroup ID="USER">
		 <macro name="BOARDTYPE" description="Board type" value="NI-PXI-6683H-NDS"/>
     		<macro name="TIMESTAMPING_NAME" description="Terminal to timestamp, please indicate the number (see NISYNC documentation)" value="TR#"/>
		
        </macroGroup>
	
</template>
