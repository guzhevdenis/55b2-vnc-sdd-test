#State Machine for the device 
file "nisync_Device.template" {
pattern
{
	BOARDTYPE,
	BOARDTYPEIDX,
	CBS1,
	CBS2
}

{
	"B",
	"0",
	"TEST",
	"FCT0"
}

}
