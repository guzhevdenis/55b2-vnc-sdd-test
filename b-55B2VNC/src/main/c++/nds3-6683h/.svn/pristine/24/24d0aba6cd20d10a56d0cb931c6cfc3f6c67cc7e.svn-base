	<variableTemplate name="HWCF:FW-STM-GLOBALSTATE">
		<direction>state</direction>
		<external>true</external>
		<raisesAlarm>true</raisesAlarm>
		<presentOnScreens>true</presentOnScreens>
		<EPICSAttributes>
			<EPICSRecord
				name="$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(FIRMWARE_NAME)-STM-getGlobalState"
				type="mbbi">
				<EPICSField name="DESC" value="" />
				<EPICSField name="DTYP" value="asynInt32" />
				<EPICSField name="INP"
				value="@asyn($(PREFIXBOARDTYPE)$(MODULEIDX),0)$(FIRMWARE_NAME)-StateMachine-getGlobalState" />
				
				<EPICSField name="ZRVL" value="0" />		
				<EPICSField name="ONVL" value="1" />		
				<EPICSField name="TWVL" value="2" />		
				<EPICSField name="THVL" value="3" />		
				<EPICSField name="FRVL" value="4" />		
				<EPICSField name="FVVL" value="5" />		
				<EPICSField name="SXVL" value="6" />		
				<EPICSField name="SVVL" value="7" />		
				<EPICSField name="EIVL" value="8" />		

				<EPICSField name="ZRST" value="UNKNOWN" />
				<EPICSField name="ONST" value="OFF" />
				<EPICSField name="TWST" value="SWITCHING_OFF" />
				<EPICSField name="THST" value="INITIALIZING" />
				<EPICSField name="FRST" value="ON" />
				<EPICSField name="FVST" value="STOPPING" />
				<EPICSField name="SXST" value="STARTING" />
				<EPICSField name="SVST" value="RUNNING" />
				<EPICSField name="EIST" value="FAULT" /> 
				<EPICSField name="SCAN" value="Passive" />
				<EPICSField name="PINI" value="1" />				
			</EPICSRecord>
		</EPICSAttributes>
	</variableTemplate>
	
	<variableTemplate name="HWCF:FW-STM-STATE">
		<direction>state</direction>
		<external>true</external>
		<raisesAlarm>true</raisesAlarm>
		<presentOnScreens>true</presentOnScreens>
		<EPICSAttributes>
			<EPICSRecord
				name="$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(FIRMWARE_NAME)-STM-getState"
				type="mbbi">
				<EPICSField name="DESC" value="Get Local State" />
				<EPICSField name="DTYP" value="asynInt32" />
				<EPICSField name="INP"
					value="@asyn($(PREFIXBOARDTYPE)$(MODULEIDX),0)$(FIRMWARE_NAME)-StateMachine-getState" />
				<EPICSField name="ZRVL" value="0" />		
				<EPICSField name="ONVL" value="1" />		
				<EPICSField name="TWVL" value="2" />		
				<EPICSField name="THVL" value="3" />		
				<EPICSField name="FRVL" value="4" />		
				<EPICSField name="FVVL" value="5" />		
				<EPICSField name="SXVL" value="6" />		
				<EPICSField name="SVVL" value="7" />
				<EPICSField name="EIVL" value="8" />
				<EPICSField name="ZRST" value="UNKNOWN" />
				<EPICSField name="ONST" value="OFF" />
				<EPICSField name="TWST" value="SWITCHING_OFF" />
				<EPICSField name="THST" value="INITIALIZING" />
				<EPICSField name="FRST" value="ON" />
				<EPICSField name="FVST" value="STOPPING" />
				<EPICSField name="SXST" value="STARTING" />
				<EPICSField name="SVST" value="RUNNING" />
				<EPICSField name="EIST" value="FAULT" />
				<EPICSField name="SCAN" value="Passive" />
				<EPICSField name="PINI" value="1" />				
			</EPICSRecord>
		</EPICSAttributes>
	</variableTemplate>	

	<variableTemplate name="HWCF:FW-STM-SETSTATE">
		<direction>state</direction>
		<external>true</external>
		<raisesAlarm>true</raisesAlarm>
		<presentOnScreens>true</presentOnScreens>
		<EPICSAttributes>
			<EPICSRecord
				name="$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(FIRMWARE_NAME)-STM-setState"
				type="mbbo">
				<EPICSField name="DESC" value="Set Local State" />
				<EPICSField name="DTYP" value="asynInt32" />
				<EPICSField name="OUT"
					value="@asyn($(PREFIXBOARDTYPE)$(MODULEIDX),0)$(FIRMWARE_NAME)-StateMachine-setState" />
				<EPICSField name="ZRVL" value="0" />		
				<EPICSField name="ONVL" value="1" />		
				<EPICSField name="TWVL" value="2" />		
				<EPICSField name="THVL" value="3" />		
				<EPICSField name="FRVL" value="4" />		
				<EPICSField name="FVVL" value="5" />		
				<EPICSField name="SXVL" value="6" />		
				<EPICSField name="SVVL" value="7" />
				<EPICSField name="EIVL" value="8" />
				<EPICSField name="ZRST" value="UNKNOWN" />
				<EPICSField name="ONST" value="OFF" />
				<EPICSField name="TWST" value="SWITCHING_OFF" />
				<EPICSField name="THST" value="INITIALIZING" />
				<EPICSField name="FRST" value="ON" />
				<EPICSField name="FVST" value="STOPPING" />
				<EPICSField name="SXST" value="STARTING" />
				<EPICSField name="SVST" value="RUNNING" />
				<EPICSField name="EIST" value="FAULT" />
				<EPICSField name="SCAN" value="Passive" />
							
			</EPICSRecord>
		</EPICSAttributes>
	</variableTemplate>
	
	<variableTemplate name="HWCF:FW-Version">
		<direction>state</direction>
		<external>true</external>
		<presentOnScreens>true</presentOnScreens>
		<EPICSAttributes>
			<EPICSRecord
				name="$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(FIRMWARE_NAME)-Version"
				type="waveform">
				<EPICSField name="DESC" value="Firmware version" />
				<EPICSField name="DTYP" value="asynInt8ArraIn" />
				<EPICSField name="FTVL" value="CHAR" />
				<EPICSField name="INP"
					value="@asyn($(BOARDTYPE)$(BOARDTYPEIDX),0)$(FIRMWARE_NAME)-Version" />
				<EPICSField name="SCAN" value="I/O Intr" />
				<EPICSField name="NELM" value="255" />
			</EPICSRecord>
		</EPICSAttributes>
	</variableTemplate>

	<macroGroup ID="USER">
		 <macro name="BOARDTYPE" description="Board type" value="NI-PXI-6683H-NDS"/> <!--Please never add an space in this value-->
     		<macro name="FIRMWARE_NAME" description="Firmware NDS Node Name" value="FW"/>
		
        </macroGroup>
	
</template>
