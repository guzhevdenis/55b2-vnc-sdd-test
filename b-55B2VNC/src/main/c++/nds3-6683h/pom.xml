<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.iter.codac.units</groupId>
  <artifactId>nds-nisync</artifactId>
  <packaging>codac</packaging>
  <version>2.2.0</version>
  <name>NDSv3 - Nisync Device Driver</name>
  <description>NDS-Nisync is an NDSv3 device support library for the NI PXI-6683H timing board,
   based on NDS (Nominal Device Support) v3 and using NI Sync Linux Device Driver.</description>
  <url>https://github.com/Cosylab/nds3</url>

  <!-- project properties -->
  <properties>
    <unit.type>module</unit.type>
  </properties>

  <!-- parent pom.xml -->
  <parent>
    <groupId>org.iter.codac.units</groupId>
    <artifactId>maven-iter-settings</artifactId>
    <version>7.4.0</version>
  </parent>

  <!-- unit owner and developers -->
  <developers>
    <developer>
      <id>langer</id>
      <roles>
        <role>unit owner</role>
      </roles>
    </developer>
    <developer>
      <id>ruizm</id>
      <roles>
        <role>developer</role>
      </roles>
    </developer>
  </developers>

  <!-- configuration of how the project is built -->
  <build>
    <!-- default phase is compile -->
    <defaultGoal>compile</defaultGoal>
    <!-- this command is executed if you just write 'mvn' -->
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-iter-plugin</artifactId>
        <extensions>true</extensions>
        <configuration>
          <packaging>
             <package>
              <!-- subdir does not work with CCSv6.0 -->
              <!-- include type="library" name="nds3-dev-nisync" subdir="nisyncDriver" / -->
              <include type="file" source="lib/libnds3-dev-nisync.so" target="lib/" />

              <requires codac="true">kmod-nisync-lib</requires>
              <requires codac="true" buildonly="true">kmod-nisync-lib-devel</requires>
              <requires codac="true">nds-core</requires>
              <requires codac="true" buildonly="true">nds-core-devel</requires>
              <requires codac="true" buildonly="true">nds-core-impl-devel</requires>
              <requires codac="true" buildonly="true">nds-core-testcontrolsystem-devel</requires>
              <requires codac="true" buildonly="true">nds-epics-devel</requires>
            </package>

            <package develof="">
              <include type="file" source="main/c++/include" target="include" />
              <requires codac="true">nds-core-devel</requires>
            </package>

            <package name="epics">
              <include type="file" source="main/epics/ndsNisyncApp/Db/nisync_Device.template" target="epics/db/" />
              <include type="file" source="main/epics/ndsNisyncApp/Db/nisync_Firmware.template" target="epics/db/" />
              <include type="file" source="main/epics/ndsNisyncApp/Db/nisync_Routing.template" target="epics/db/" />
              <include type="file" source="main/epics/ndsNisyncApp/Db/nisync_Timing.template" target="epics/db/" />
              <include type="file" source="main/epics/ndsNisyncApp/Db/nisync_Terminal.template" target="epics/db/" />

              <requires codac="true">nds-nisync</requires>
              <requires codac="true">nds-epics</requires>
              <requires codac="true" buildonly="true">nds-epics-devel</requires>
            </package>

            <package name="doc">
              <include type="doxygen" name="${project.artifactId}" project="${project.name}" version="${project.version}" optimize="c">
                <filepattern>*.dox</filepattern>
                <filepattern>*.h</filepattern>
                <filepattern>*.cpp</filepattern>
                <outputformat>html</outputformat>
                <outputformat>pdf</outputformat>
                <input>main/c++/doc</input>
                <input>main/c++/nisyncDriver/</input>
                <input>main/c++/include</input>
                <imagepath>doc</imagepath>
                <properties>
                  <SORT_MEMBER_DOCS>NO</SORT_MEMBER_DOCS>
                  <HIDE_UNDOC_CLASSES>YES</HIDE_UNDOC_CLASSES>
                  <RECURSIVE>YES</RECURSIVE>
                  <EXTRACT_ALL>YES</EXTRACT_ALL>
                  <HIDE_UNDOC_MEMBERS>NO</HIDE_UNDOC_MEMBERS>
                  <EXTRACT_PRIVATE>YES</EXTRACT_PRIVATE>
                  <SOURCE_BROWSER>YES</SOURCE_BROWSER>
                  <DOT_FONTSIZE>10</DOT_FONTSIZE>
                  <CLASS_GRAPH>YES</CLASS_GRAPH>
                  <COLLABORATION_GRAPH>YES</COLLABORATION_GRAPH>
                  <GROUP_GRAPHS>YES</GROUP_GRAPHS>
                  <INCLUDE_GRAPH>YES</INCLUDE_GRAPH>
                  <INCLUDED_BY_GRAPH>YES</INCLUDED_BY_GRAPH>
                  <CALL_GRAPH>YES</CALL_GRAPH>
                  <CALLER_GRAPH>YES</CALLER_GRAPH>
                  <GRAPHICAL_HIERARCHY>YES</GRAPHICAL_HIERARCHY>
                  <DIRECTORY_GRAPH>YES</DIRECTORY_GRAPH>
                  <DOT_IMAGE_FORMAT>png</DOT_IMAGE_FORMAT>
                  <EXTRACT_STATIC>YES</EXTRACT_STATIC>
                  <GENERATE_TREEVIEW>YES</GENERATE_TREEVIEW>
                </properties>
              </include>
            </package>
                         	    
            <package name="epics-sample">
              <include type="source" source="src/main/epics/configure" target="examples/nds-nisync-epics/src/main/epics/configure" />
              <include type="source" source="src/main/epics/Makefile" target="examples/nds-nisync-epics/src/main/epics/Makefile" />
	      	  <include type="source" source="src/main/epics/iocBoot" target="examples/nds-nisync-epics/src/main/epics/iocBoot" />
              <include type="source" source="src/main/epics/ndsNisyncApp" target="examples/nds-nisync-epics/src/main/epics/ndsNisyncApp" />
              <include type="source" source="epics-example-pom.xml" target="examples/nds-nisync-epics/pom.xml" />
              <include type="source" source="src/main/boy" target="examples/nds-nisync-epics/src/main/boy" />
              <requires codac="true">nds-nisync-devel</requires>
            </package>

	   <package name="sdd">
  		<arch>noarch</arch>
  		<summary>XML descriptions used to configure SDD</summary>
  		<include type="file" source="main/sdd" target="sdd/xml/modules" />

		<scriptlet type="posttrans">
			<![CDATA[
						%{codac_bin}/sdd-sync-classic load /opt/codac/sdd/xml/modules/HardwareNDSNIPXI6683H.xml 
						%{codac_bin}/sdd-sync-classic load /opt/codac/sdd/xml/modules/EPICSNDSNISync.xml 
						%{codac_bin}/sdd-sync-classic load /opt/codac/sdd/xml/modules/TemplateNDSNISyncDevice.xml
						%{codac_bin}/sdd-sync-classic load /opt/codac/sdd/xml/modules/TemplateNDSNISyncFirmware.xml
						%{codac_bin}/sdd-sync-classic load /opt/codac/sdd/xml/modules/TemplateNDSNISyncTiming.xml
						%{codac_bin}/sdd-sync-classic load /opt/codac/sdd/xml/modules/TemplateNDSNISyncRouting.xml
						%{codac_bin}/sdd-sync-classic load /opt/codac/sdd/xml/modules/TemplateNDSNISyncTerminal.xml
			]]>
		</scriptlet> 
		<scriptlet type="preun">
			<![CDATA[
						%{codac_bin}/psql-sdd-rw -c "SELECT deletecodactemplate('nds-nisync-Terminal',600,1)"
						%{codac_bin}/psql-sdd-rw -c "SELECT deletecodactemplate('nds-nisync-Routing',600,1)"
						%{codac_bin}/psql-sdd-rw -c "SELECT deletecodactemplate('nds-nisync-Timing',600,1)"
						%{codac_bin}/psql-sdd-rw -c "SELECT deletecodactemplate('nds-nisync-Firmware',600,1)"
						%{codac_bin}/psql-sdd-rw -c "SELECT deletecodactemplate('nds-nisync-Device',600,1)"
						%{codac_bin}/psql-sdd-rw -c "SELECT deleteepicssupport('ndsnisync',600)"
						%{codac_bin}/psql-sdd-rw -c "SELECT deleteiomodule('NI PXI-6683H-NDS')"
			]]>
		</scriptlet> 
	   </package>
            
          </packaging>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
