#PROXY MP
record(waveform, "D1-I2-HWCF:B-0-NeutronProfile") {
    field(DTYP, "asynInt32ArrayIn")
    field(FTVL, "LONG")
    field(SCAN, "1 second")
    field(INP, "@asyn(B-0,0)NeutronProfile")
    field(NELM, "100")
}

record(calcout, "TEST:RandomAI") {
    field(DESC, "Random number from 100000 to 102000")
    field(CALC, "100000 + RNDM * 2000")
    field(SCAN, "1 second")
    field(OUT,  "TEST:DiamondCountRate")
}

record(ai, "TEST:DiamondCountRate") {
    field(DESC, "Random analog countrate")
    field(PREC, "2")
    field(SCAN, "1 second")
}

record(calcout, "TEST:RandomAI_2") {
    field(DESC, "Random number from 100000 to 102000")
    field(CALC, "100000 + RNDM * 2000")
    field(SCAN, "1 second")
    field(OUT,  "TEST:FissionCountRate")
}

record(ai, "TEST:FissionCountRate") {
    field(DESC, "Random analog countrate")
    field(PREC, "2")
    field(SCAN, "1 second")
}











