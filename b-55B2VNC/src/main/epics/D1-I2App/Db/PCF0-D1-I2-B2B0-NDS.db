
#include "nds3_StateMachine.template"
#include "nds3_DataAcquisition.template"

#Debug and not FPGA variables

#INDICATORS
record(ai, "D1-I2-HWCF:B-0-Status") {
    field(DESC, "Status")
    field(DTYP, "asynInt32")
    field(SCAN, "1 second")
    field(INP, "@asyn(B-0,0)Status")
    field(VAL, "0")
}

#CONTORLS
record(ao, "D1-I2-HWCF:B-0-Reseter") {
    field(DESC, "Reset")
    field(DTYP, "asynInt32")
    field(SCAN, "Passive")
    field(OUT, "@asyn(B-0,0)Reseter")
    field(VAL, "0")
}

record (ai, "D1-I2-HWCF:B-0-CountRateAverage")
{
	field (DESC, "CountRateAverage")
	field (DTYP, "asynFloat64")
	field (SCAN, ".1 second")
	field (INP, "@asyn(B-0,0)CountRateAverage")
}

record (ai, "D1-I2-HWCF:B-0-MSV")
{
	field (DESC, "MSV")
	field (DTYP, "asynFloat64")
	field (SCAN, ".1 second")
	field (INP, "@asyn(B-0,0)MSV")
}
