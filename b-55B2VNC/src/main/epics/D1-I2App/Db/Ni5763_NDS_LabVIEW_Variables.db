    field(DESC, "Expected I/O module ID")
    field(DTYP, "asynInt64")
    field(SCAN, "1 second")
    field(INP, "@asyn(B-8,0)Expected_ID")
}
record(ai, "D1-I2-HWCF:B-8-Inserted_ID") {
    field(DESC, "Actual I/O module ID")
    field(DTYP, "asynInt64")
    field(SCAN, "1 second")
    field(INP, "@asyn(B-8,0)Inserted_ID")
}
