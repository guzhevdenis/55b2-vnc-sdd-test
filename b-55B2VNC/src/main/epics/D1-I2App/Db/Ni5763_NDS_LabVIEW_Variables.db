#File must be renamed
#Variables description required

#INDICATORS
record(ai, "D1-I2-HWCF:B-8-Status") {
    field(DESC, "Status")
    field(DTYP, "asynInt32")
    field(SCAN, "1 second")
    field(INP, "@asyn(B-8,0)Status")
    field(VAL, "0")
}
record(ai, "D1-I2-HWCF:B-8-DAQ_On") {
    field(DESC, "Shows if Data Acquisition turned on")
    field(DTYP, "asynInt32")
    field(SCAN, "1 second")
    field(INP, "@asyn(B-8,0)DAQ_On")
}
record(ai, "D1-I2-HWCF:B-8-Input_Valid") {
    field(DESC, "Validness of data input")
    field(DTYP, "asynInt32")
    field(SCAN, "1 second")
    field(INP, "@asyn(B-8,0)Input_Valid")
}
record(ai, "D1-I2-HWCF:B-8-ReadyForInput") {
    field(DESC, "Shows if data is ready for input")
    field(DTYP, "asynInt32")
    field(SCAN, "1 second")
    field(INP, "@asyn(B-8,0)ReadyForInput")
}
record(ai, "D1-I2-HWCF:B-8-EEPROMPowerEnabled") {
    field(DESC, "Shows EEPROM state")
    field(DTYP, "asynInt32")
    field(SCAN, "1 second")
    field(INP, "@asyn(B-8,0)EEPROMPowerEnabled")
}
