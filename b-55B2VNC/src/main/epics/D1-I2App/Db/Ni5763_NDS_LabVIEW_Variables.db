#CONFIGURE FIFO DEPTH
record(ao, "D1-I2-HWCF:B-8-ConfigFIFO_Depth") {
    field(DESC, "Set FIFO depth")
    field(DTYP, "asynInt32")
    field(SCAN, "Passive")
    field(OUT, "@asyn(B-8,0)ConfigFIFO_Depth")
    field(PINI, "YES")
}

#CONTROLS
record(ao, "D1-I2-HWCF:B-8-Reseter") {
    field(DESC, "Reset")
    field(DTYP, "asynInt32")
    field(SCAN, "Passive")
    field(OUT, "@asyn(B-8,0)Reseter")
    field(VAL, "0")
}
record(ao, "D1-I2-HWCF:B-8-EnableDAQ") {
    field(DESC, "On/off Data Acquisition")
    field(DTYP, "asynInt32")
    field(SCAN, "Passive")
    field(OUT, "@asyn(B-8,0)EnableDAQ")
    field(PINI, "YES")
}
record(ao, "D1-I2-HWCF:B-8-FirstExpCoeff") {
    field(DESC, "Set 1st exponential filter coefficient")
    field(DTYP, "asynInt32")
    field(SCAN, "Passive")
    field(OUT, "@asyn(B-8,0)FirstExpCoeff")
    field(PINI, "YES")
}
record(ao, "D1-I2-HWCF:B-8-SecondExpCoeff") {
    field(DESC, "Set 2nd exponential filter coefficient")
    field(DTYP, "asynInt32")
    field(SCAN, "Passive")
    field(OUT, "@asyn(B-8,0)SecondExpCoeff")
    field(PINI, "YES")
}
record(mbbo, "D1-I2-HWCF:B-8-Type") {
    field(DESC, "Set type of filtration")
    field(DTYP, "asynInt32")
    field(SCAN, "Passive")
    field(OUT, "@asyn(B-8,0)Type")
    field(ZRVL, 0)
    field(ZRST, "Exponential")
    field(ONVL, 1)
    field(ONST, "Median window 15 points")
    field(TWVL, 2)
    field(TWST, "Median window 21 points")
    field(THVL, 3)
    field(THST, "Median window 27 points")
    field(VAL, "0")
    field(IVOA, "Set output to IVOV")
    field(IVOV, "0")
    field(PINI, "YES")
}
record(ao, "D1-I2-HWCF:B-8-CalibrationCoefficient") {
    field(DESC, "Set calibration coefficient")
    field(DTYP, "asynFloat64")
    field(SCAN, "Passive")
    field(OUT, "@asyn(B-8,0)CalibrationCoefficient")
    field(PINI, "YES")
}
record(ao, "D1-I2-HWCF:B-8-Threshold") {
    field(DESC, "Set threshold")
    field(DTYP, "asynFloat64")
    field(SCAN, "Passive")
    field(OUT, "@asyn(B-8,0)Threshold")
    field(PINI, "YES")
}
record(ao, "D1-I2-HWCF:B-8-SinglePulseMax") {
    field(DESC, "Set maximum single pulses")
    field(DTYP, "asynInt32")
    field(SCAN, "Passive")
    field(OUT, "@asyn(B-8,0)SinglePulseMax")
    field(PINI, "YES")
}
record(ao, "D1-I2-HWCF:B-8-SinglePulseMin") {
    field(DESC, "Set minimum single pulses")
    field(DTYP, "asynInt32")
    field(SCAN, "Passive")
    field(OUT, "@asyn(B-8,0)SinglePulseMin")
    field(PINI, "YES")
}
record(ao, "D1-I2-HWCF:B-8-TotalPulseMin") {
    field(DESC, "Set minimum total pulses")
    field(DTYP, "asynInt32")
    field(SCAN, "Passive")
    field(OUT, "@asyn(B-8,0)TotalPulseMin")
    field(PINI, "YES")
}

