    field(DESC, "I/O module init done")
    field(DTYP, "asynInt32")
    field(SCAN, "1 second")
    field(INP, "@asyn(B-8,0)InitializationDone")
}
record(ai, "D1-I2-HWCF:B-8-Clk100PLL_Unlocked") {
    field(DESC, "Lock loss on PLL frequency of 100 MHz")
    field(DTYP, "asynInt32")
    field(SCAN, "1 second")
    field(INP, "@asyn(B-8,0)Clk100PLL_Unlocked")
}
