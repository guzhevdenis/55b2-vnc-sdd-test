    field(DESC, "Single rate PV for display on graph")
    field(DTYP, "asynFloat64ArrayIn")
    field(FTVL, "DOUBLE")
    field(NELM, "320")
    field(SCAN, "I/O Intr")
    field(INP, "@asyn(B-8,0)SingleRateData")
    field(PINI, "YES")
}
