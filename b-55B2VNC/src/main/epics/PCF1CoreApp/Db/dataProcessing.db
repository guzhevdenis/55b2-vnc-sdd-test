record(ao,"TEST-FCT0-HWCF:B-4-Mode") {
    field(DESC,"DataGenerator mode")
    field(DTYP,"asynInt32")
    field(SCAN,"Passive")
    field(OUT,"@asyn(B-4,0)Mode")
    field(PREC,"0")
    field(DRVL,"0")
    field(DRVH,"1")
    field(VAL,"1")  # default to NeutronProfile
}

record(bo,"TEST-FCT0-HWCF:B-4-Publish") {
    field(DESC,"Publish all temperatures once")
    field(DTYP,"asynInt32")
    field(SCAN,"Passive")
    field(OUT,"@asyn(B-4,0)Publish")
    field(ZNAM,"IDLE")
    field(ONAM,"PUBLISH")
}

record(waveform,"NuclearProfile"){
    field(DESC,"Nuclear Profile")
    field(DTYP,"asynFloat32ArrayIn")
    field(SCAN,"1 second")
    field(INP,"@asyn(B-3,0)NuclearProfile")
    field(FTVL, "FLOAT")
    field(NELM,"920")
}
record(ai,"PlasmaParameter"){
    field(DESC,"Plasma Parameter")
    field(DTYP,"asynFloat64")
    field(SCAN,"1 second")
    field(INP,"@asyn(B-3,0)PlasmaParameter")
}
record(ai,"TEST-FCT0-HWCF:B-4-Temperature00"){
    field(DESC,"Device Temperature")
    field(DTYP,"asynFloat64")
    field(SCAN,"Passive")
    field(PINI,"YES")
    field(INP,"@asyn(B-4,0)Temperature00")
}
