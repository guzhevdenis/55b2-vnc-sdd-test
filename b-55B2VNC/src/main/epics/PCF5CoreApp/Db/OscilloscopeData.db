#INDICATOR
record(ai, "D1-I2-HWCF:B-7-Status") {
    field(DESC, "Status")
    field(DTYP, "asynInt32")
    field(SCAN, "1 second")
    field(INP, "@asyn(B-7,0)Status")
    field(VAL, "0")
}
#CONTORL
record(ao, "D1-I2-HWCF:B-7-Reseter") {
    field(DESC, "Reset")
    field(DTYP, "asynInt32")
    field(SCAN, "Passive")
    field(OUT, "@asyn(B-7,0)Reseter")
    field(VAL, "0")
}

