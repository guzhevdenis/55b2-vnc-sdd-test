record(ao, "D1-I2-HWCF:SDN-0-publishingRate") {
    field(DESC, "Publishing rate (us) for the SDN Topic. ")
    field(DTYP, "asynInt32")
    field(OUT, "@asyn(SDN-0, 0)publishingRate")    
}

record(mbbi, "D1-I2-HWCF:SDN-0-StateMachine-getGlobalState") {
    field(DESC, "")
    field(DTYP, "asynInt32")
    field(SCAN, "Passive")
    field(PINI, 1)
    field(INP, "@asyn(SDN-0, 0)StateMachine-getGlobalState")
    field(ZRVL, 0)
    field(ZRST, "UNKNOWN")
    field(ONVL, 1)
    field(ONST, "OFF")
    field(TWVL, 2)
    field(TWST, "SWITCHING_OFF")
    field(THVL, 3)
    field(THST, "INITIALIZING")
    field(FRVL, 4)
    field(FRST, "ON")
    field(FVVL, 5)
    field(FVST, "STOPPING")
    field(SXVL, 6)
    field(SXST, "STARTING")
    field(SVVL, 7)
    field(SVST, "RUNNING")
    field(EIVL, 8)
    field(EIST, "FAULT")
}

record(mbbi, "D1-I2-HWCF:SDN-0-StateMachine-getState") {
    field(DESC, "Get local state")
    field(DTYP, "asynInt32")
    field(SCAN, "I/O Intr")
    field(PINI, 1)
    field(INP, "@asyn(SDN-0, 0)StateMachine-getState")
    field(ZRVL, 0)
    field(ZRST, "UNKNOWN")
    field(ONVL, 1)
    field(ONST, "OFF")
    field(TWVL, 2)
    field(TWST, "SWITCHING_OFF")
    field(THVL, 3)
    field(THST, "INITIALIZING")
    field(FRVL, 4)
    field(FRST, "ON")
    field(FVVL, 5)
    field(FVST, "STOPPING")
    field(SXVL, 6)
    field(SXST, "STARTING")
    field(SVVL, 7)
    field(SVST, "RUNNING")
    field(EIVL, 8)
    field(EIST, "FAULT")
}

record(mbbo, "D1-I2-HWCF:SDN-0-StateMachine-setState") {
    field(DESC, "Set local state")
    field(DTYP, "asynInt32")
    field(SCAN, "Passive")
    field(PINI, 1)
    field(OUT, "@asyn(SDN-0, 0)StateMachine-setState")
    field(ONVL, 1)
    field(ONST, "OFF")
    field(FRVL, 4)
    field(FRST, "ON")
    field(SVVL, 7)
    field(SVST, "RUNNING")
}