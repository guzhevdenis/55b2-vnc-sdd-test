# Data-acquisition node state machine (device-level STM is loaded separately).

record(mbbi, "D1-I2-HWCF:B-8-DataAcquisitionNode_FissCh-getGlobalState") {
    field(DESC, "Get global state")
    field(DTYP, "asynInt32")
    field(SCAN, ".1 second")
    field(INP, "@asyn(B-8,0)DataAcquisitionNode_FissCh-StateMachine-getGlobalState")
    field(ZRVL, 0)
    field(ZRST, "UNKNOWN")
    field(ZRSV, "MINOR")
    field(ONVL, 1)
    field(ONST, "OFF")
    field(TWVL, 2)
    field(TWST, "SWITCHING_OFF")
    field(THVL, 3)
    field(THST, "INITIALIZING")
    field(FRVL, 4)
    field(FRST, "ON")
    field(FVVL, 5)
    field(FVST, "STOPPING")
    field(SXVL, 6)
    field(SXST, "STARTING")
    field(SVVL, 7)
    field(SVST, "RUNNING")
    field(EIVL, 8)
    field(EIST, "FAULT")
    field(EISV, "MAJOR")
    field(PINI, 1)
}

record(mbbi, "D1-I2-HWCF:B-8-DataAcquisitionNode_FissCh-getState") {
    field(DESC, "Get local state")
    field(DTYP, "asynInt32")
    field(SCAN, "I/O Intr")
    field(INP, "@asyn(B-8,0)DataAcquisitionNode_FissCh-StateMachine-getState")
    field(ZRVL, 0)
    field(ZRST, "UNKNOWN")
    field(ZRSV, "MINOR")
    field(ONVL, 1)
    field(ONST, "OFF")
    field(TWVL, 2)
    field(TWST, "SWITCHING_OFF")
    field(THVL, 3)
    field(THST, "INITIALIZING")
    field(FRVL, 4)
    field(FRST, "ON")
    field(FVVL, 5)
    field(FVST, "STOPPING")
    field(SXVL, 6)
    field(SXST, "STARTING")
    field(SVVL, 7)
    field(SVST, "RUNNING")
    field(EIVL, 8)
    field(EIST, "FAULT")
    field(EISV, "MAJOR")
    field(PINI, 1)
}

record(mbbo, "D1-I2-HWCF:B-8-DataAcquisitionNode_FissCh-setState") {
    field(DESC, "Set local state")
    field(DTYP, "asynInt32")
    field(SCAN, "Passive")
    field(OUT, "@asyn(B-8,0)DataAcquisitionNode_FissCh-StateMachine-setState")
    field(ONVL, 1)
    field(ONST, "OFF")
    field(FRVL, 4)
    field(FRST, "ON")
    field(SVVL, 7)
    field(SVST, "RUNNING")
    field(PINI, 1)
}

# Rest of PVs

record(waveform, "D1-I2-HWCF:B-8-DataAcquisitionNode_FissCh-Data") {
    field(DESC, "Acquired data")
    field(DTYP, "asynInt32ArrayIn")
    field(FTVL, "LONG")
    field(NELM, "10240")
    field(SCAN, "I/O Intr")
    field(INP, "@asyn(B-8,0)DataAcquisitionNode_FissCh-Data")
}

