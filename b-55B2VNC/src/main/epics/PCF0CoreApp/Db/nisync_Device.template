record(mbbi, "$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-ErrorSev") {
    field(DESC, "NISYNC error severity")
    field(DTYP, "asynInt32")
    field(SCAN, "I/O Intr")
    field(INP, "@asyn($(BOARDTYPE)-$(BOARDTYPEIDX), 0)ErrorSev")
    field(UNSV, "INVALID")
    field(ZRVL, 0)
    field(ZRST, "NO_ALARM")
    field(ZRSV, "NO_ALARM")
    field(ONVL, 1)
    field(ONST, "MINOR")
    field(ONSV, "MINOR")
    field(TWVL, 2)
    field(TWST, "MAJOR")
    field(TWSV, "MAJOR")
    field(THVL, 3)
    field(THST, "INVALID")
    field(THSV, "INVALID")
}
record(waveform, "$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-ErrorSrc") {
    field(DESC, "NISYNC error source")
    field(DTYP, "asynInt8ArrayIn")
    field(FTVL, "CHAR")
    field(SCAN, "I/O Intr")
    field(NELM, "255")
    field(INP, "@asyn($(BOARDTYPE)-$(BOARDTYPEIDX), 0)ErrorSrc")
}
record(waveform, "$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-ErrorMsg") {
    field(DESC, "NISYNC error message")
    field(DTYP, "asynInt8ArrayIn")
    field(FTVL, "CHAR")
    field(SCAN, "I/O Intr")
    field(NELM, "255")
    field(INP, "@asyn($(BOARDTYPE)-$(BOARDTYPEIDX), 0)ErrorMsg")
}

record(bo, "$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-ClearErrorMsg") {
    field(DESC, "Clear the last error message")
    field(DTYP, "asynInt32")
    field(SCAN, "Passive")
	field(OUT, "@asyn($(BOARDTYPE)-$(BOARDTYPEIDX), 0)ClearErrorMsg")
    field(ZNAM, "OFF")
    field(ONAM, "ON")
}

record(bo, "$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-ClearDeviceFTE") {
    field(DESC, "Clear all device's FTEs")
    field(DTYP, "asynInt32")
    field(SCAN, "Passive")
	field(OUT, "@asyn($(BOARDTYPE)-$(BOARDTYPEIDX), 0)ClearDeviceFTE")
    field(ZNAM, "OFF")
    field(ONAM, "ON")
}

#STATEMACHINE

record(mbbi, "$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-STM-getGlobalState") {
    field(DESC, "Get global state")
    field(DTYP, "asynInt32")
    field(SCAN, ".1 second")
    field(INP, "@asyn($(BOARDTYPE)-$(BOARDTYPEIDX), 0)StateMachine-getGlobalState")
    field(ZRVL, 0)
    field(ZRST, "UNKNOWN")
    field(ZRSV, "MINOR")
    field(ONVL, 1)
    field(ONST, "OFF")
    field(TWVL, 2)
    field(TWST, "SWITCHING_OFF")
    field(THVL, 3)
    field(THST, "INITIALIZING")
    field(FRVL, 4)
    field(FRST, "ON")
    field(FVVL, 5)
    field(FVST, "STOPPING")
    field(SXVL, 6)
    field(SXST, "STARTING")
    field(SVVL, 7)
    field(SVST, "RUNNING")
    field(EIVL, 8)
    field(EIST, "FAULT")
    field(EISV, "MAJOR")
    field(PINI, 1)
}

