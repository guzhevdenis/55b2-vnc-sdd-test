record(ai, "$(CBS1)-$(CBS2)-HWCF:$(BOARDTYPE)-$(BOARDTYPEIDX)-$(DAN_NAME)-TimeBetweenBlocks_RBV") {
    field(DESC, "Readback value of time between blocks")
    field(DTYP, "asynFloat64")
    field(SCAN, "I/O Intr")
    field(INP, "@asyn($(BOARDTYPE)-$(BOARDTYPEIDX), 0)$(DAN_REASON)-TimeBetweenBlocks_RBV")
