            <EPICSAttributes>
               <EPICSRecord name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-$(IOCTYPE)-SOQSIZE" type="ai">
                  <EPICSField name="INP" value="@scanOnceQueueSize"/>
                  <EPICSField name="DESC" value="Max # entries in IOC scanOnce queue"/>
                  <EPICSField name="DTYP" value="IOC stats"/>
                  <EPICSField name="PINI" value="YES"/>
               </EPICSRecord>
            </EPICSAttributes>
            <PULSEAttributes>
               <attribute name="isConfiguredByPulseScheduling">
                  <value>false</value>
               </attribute>
            </PULSEAttributes>
         </variableTemplate>
         <variableTemplate name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-$(IOCTYPE)-CBLQHIP">
            <direction>state</direction>
            <kind>continuous</kind>
            <external>true</external>
            <raisesAlarm>false</raisesAlarm>
            <archivingInfo enabled="false">
               <samplingFrequency>0.0</samplingFrequency>
            </archivingInfo>
            <storage>volatile</storage>
            <presentOnScreens>true</presentOnScreens>
            <displayIndex>0</displayIndex>
            <EPICSAttributes>
               <EPICSRecord name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-$(IOCTYPE)-CBLQHIP"
                             type="calc">
                  <EPICSField name="INPA"
                               value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-$(IOCTYPE)-CBLQHI NPP MS"/>
                  <EPICSField name="EGU" value="%"/>
                  <EPICSField name="DESC" value="Max. usage of IOC's cbLow queue"/>
                  <EPICSField name="INPB"
                               value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-$(IOCTYPE)-CBQSIZE NPP MS"/>
                  <EPICSField name="CALC" value="100*A/B"/>
                  <EPICSField name="HOPR" value="100"/>
                  <EPICSField name="LOPR" value="0"/>
               </EPICSRecord>
            </EPICSAttributes>
            <PULSEAttributes>
               <attribute name="isConfiguredByPulseScheduling">
                  <value>false</value>
               </attribute>
            </PULSEAttributes>
         </variableTemplate>
         <variableTemplate name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-$(IOCTYPE)-CPUUTL">
            <direction>state</direction>
            <kind>continuous</kind>
            <external>true</external>
            <raisesAlarm>false</raisesAlarm>
            <archivingInfo enabled="false">
               <samplingFrequency>0.0</samplingFrequency>
            </archivingInfo>
            <storage>volatile</storage>
            <presentOnScreens>true</presentOnScreens>
            <displayIndex>0</displayIndex>
            <EPICSAttributes>
               <EPICSRecord name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-$(IOCTYPE)-CPUUTL" type="ai">
                  <EPICSField name="EGU" value="%"/>
                  <EPICSField name="INP" value="@ioc_cpuload"/>
                  <EPICSField name="PREC" value="2"/>
                  <EPICSField name="DTYP" value="IOC stats"/>
                  <EPICSField name="ADEL" value="10"/>
                  <EPICSField name="HIHI" value="80"/>
                  <EPICSField name="HHSV" value="MAJOR"/>
                  <EPICSField name="HIGH" value="60"/>
                  <EPICSField name="VAL" value="NaN"/>
                  <EPICSField name="MDEL" value="1"/>
                  <EPICSField name="HOPR" value="100"/>
                  <EPICSField name="PINI" value="YES"/>
                  <EPICSField name="DESC" value="IOC CPU Load(%)"/>
                  <EPICSField name="SCAN" value="I/O Intr"/>
                  <EPICSField name="HSV" value="MINOR"/>
                  <EPICSField name="LOPR" value="0"/>
                  <EPICSField name="HYST" value="1"/>
               </EPICSRecord>
            </EPICSAttributes>
            <PULSEAttributes>
               <attribute name="isConfiguredByPulseScheduling">
                  <value>false</value>
               </attribute>
            </PULSEAttributes>
         </variableTemplate>
         <macroGroup ID="USER"/>
      </template>
      <template name="picmg-sensors"
                 version="610"
                 description="template for picmg sensors variables"
                 forEveryIOC="false"
