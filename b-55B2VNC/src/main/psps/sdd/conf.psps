      </template>
      <template name="sysmon"
                 version="632"
                 description="template for sysmon variables"
                 forEveryIOC="false"
                 userDefined="false"
                 system="false"
                 userCanInstanciate="false"
                 usesSubstitutionFiles="false"
                 required="true">
         <applicableToControlUnit>PSH</applicableToControlUnit>
         <applicableToControlUnit>PCF</applicableToControlUnit>
         <applicableToControlUnit>SRV</applicableToControlUnit>
         <location>sysmon.db</location>
         <EPICSDBDName>sysmon.dbd</EPICSDBDName>
         <EPICSLibraryName>sysmon</EPICSLibraryName>
         <group>SYSM</group>
         <variableTemplate name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-SHLTCL">
            <direction>state</direction>
            <kind>continuous</kind>
            <external>true</external>
            <raisesAlarm>false</raisesAlarm>
            <archivingInfo enabled="false">
               <samplingFrequency>0.0</samplingFrequency>
            </archivingInfo>
            <storage>volatile</storage>
            <presentOnScreens>false</presentOnScreens>
            <displayIndex>0</displayIndex>
            <EPICSAttributes>
               <EPICSRecord name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-SHLTCL" type="calcout">
                  <EPICSField name="DESC" value="Local PV calculation for SHLT"/>
                  <EPICSField name="CALC"
                               value="(A&gt;=1?1:0)+(B&gt;=1?1:0)+(C&gt;=1?1:0)+(D&gt;=1?1:0)+((E&gt;=1?1:0)||(F&gt;=1?1:0))"/>
                  <EPICSField name="INPE" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-PS.SEVR"/>
                  <EPICSField name="INPD" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-FDUTL.SEVR"/>
                  <EPICSField name="FLNK" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-SHLTCS"/>
                  <EPICSField name="PHAS" value="6"/>
                  <EPICSField name="INPA" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-CPUUTL.SEVR"/>
                  <EPICSField name="INPC" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-DISKUTL.SEVR"/>
                  <EPICSField name="INPB" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-MEMUTL.SEVR"/>
                  <EPICSField name="SCAN" value="1 second"/>
                  <EPICSField name="INPF" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-PROCSTS.SEVR"/>
               </EPICSRecord>
            </EPICSAttributes>
            <PULSEAttributes>
               <attribute name="isConfiguredByPulseScheduling">
                  <value>false</value>
               </attribute>
            </PULSEAttributes>
         </variableTemplate>
         <variableTemplate name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-NSBPS">
            <direction>state</direction>
            <kind>continuous</kind>
            <external>true</external>
            <raisesAlarm>false</raisesAlarm>
            <archivingInfo enabled="true">
               <samplingMode>monitor</samplingMode>
               <samplingFrequency>1.0</samplingFrequency>
            </archivingInfo>
            <controlsArchivingGroup>false</controlsArchivingGroup>
            <storage>volatile</storage>
            <presentOnScreens>true</presentOnScreens>
            <displayIndex>0</displayIndex>
            <EPICSAttributes>
               <EPICSRecord name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-NSBPS" type="ai">
                  <EPICSField name="MDEL" value="1"/>
                  <EPICSField name="EGU" value="KBps"/>
                  <EPICSField name="VAL" value="NaN"/>
                  <EPICSField name="PINI" value="YES"/>
                  <EPICSField name="ADEL" value="1000"/>
                  <EPICSField name="DTYP" value="sysmon"/>
                  <EPICSField name="DESC" value="Send Kbytes/sec (PON)"/>
                  <EPICSField name="INP" value="@net_send_bps:PON"/>
                  <EPICSField name="SCAN" value="I/O Intr"/>
                  <EPICSField name="PREC" value="1"/>
               </EPICSRecord>
            </EPICSAttributes>
            <PULSEAttributes>
               <attribute name="isConfiguredByPulseScheduling">
                  <value>false</value>
               </attribute>
            </PULSEAttributes>
         </variableTemplate>
         <variableTemplate name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-SYSHLT">
            <direction>state</direction>
            <kind>continuous</kind>
            <external>true</external>
            <raisesAlarm>false</raisesAlarm>
            <archivingInfo enabled="false">
               <samplingFrequency>0.0</samplingFrequency>
            </archivingInfo>
            <storage>volatile</storage>
            <presentOnScreens>false</presentOnScreens>
            <displayIndex>0</displayIndex>
            <EPICSAttributes>
               <EPICSRecord name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-SYSHLT" type="calcout">
                  <EPICSField name="DESC" value="System health"/>
                  <EPICSField name="HIGH" value="1"/>
                  <EPICSField name="INPA" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-CPUUTL.SEVR"/>
                  <EPICSField name="SCAN" value="1 second"/>
                  <EPICSField name="INPC" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-DISKUTL.SEVR"/>
                  <EPICSField name="INPB" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-MEMUTL.SEVR"/>
                  <EPICSField name="HSV" value="MINOR"/>
                  <EPICSField name="CALC"
                               value="((A&gt;=1?1:0)|(B&gt;=1?2:0)|(C&gt;=1?4:0)|(D&gt;=1?8:0))&amp;(B&gt;2?0:15)"/>
                  <EPICSField name="FLNK" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-SYSHLTS"/>
                  <EPICSField name="INPD" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-FDUTL.SEVR"/>
               </EPICSRecord>
            </EPICSAttributes>
            <PULSEAttributes>
               <attribute name="isConfiguredByPulseScheduling">
                  <value>false</value>
               </attribute>
            </PULSEAttributes>
         </variableTemplate>
         <variableTemplate name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-SHLTC">
            <direction>state</direction>
            <kind>continuous</kind>
            <external>true</external>
            <raisesAlarm>false</raisesAlarm>
            <archivingInfo enabled="false">
               <samplingFrequency>0.0</samplingFrequency>
            </archivingInfo>
            <storage>volatile</storage>
            <presentOnScreens>false</presentOnScreens>
            <displayIndex>0</displayIndex>
            <EPICSAttributes>
               <EPICSRecord name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-SHLTC" type="calcout">
                  <EPICSField name="DESC" value="Final Calculation for SHLT"/>
                  <EPICSField name="SCAN" value="1 second"/>
                  <EPICSField name="INPA" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-SHLTCS"/>
                  <EPICSField name="PHAS" value="8"/>
                  <EPICSField name="CALC" value="(A&gt;=3?3:A)"/>
                  <EPICSField name="FLNK" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-SHLT"/>
               </EPICSRecord>
            </EPICSAttributes>
            <PULSEAttributes>
               <attribute name="isConfiguredByPulseScheduling">
                  <value>false</value>
               </attribute>
            </PULSEAttributes>
         </variableTemplate>
