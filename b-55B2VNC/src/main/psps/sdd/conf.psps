      <template name="sysmon-tcnd"
                 version="610"
                 description="template for tcnd monitoring variables"
                 forEveryIOC="false"
                 userDefined="false"
                 system="false"
                 userCanInstanciate="false"
                 usesSubstitutionFiles="false"
                 required="true">
         <applicableToControlUnit>PCF</applicableToControlUnit>
         <location>sysmon-tcnd.db</location>
         <EPICSDBDName>sysmon.dbd</EPICSDBDName>
         <EPICSLibraryName>sysmon</EPICSLibraryName>
         <group>SYSM</group>
         <variableTemplate name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-TUPTIME">
            <direction>state</direction>
            <kind>continuous</kind>
            <external>true</external>
            <raisesAlarm>false</raisesAlarm>
            <archivingInfo enabled="false">
               <samplingFrequency>0.0</samplingFrequency>
            </archivingInfo>
            <storage>volatile</storage>
            <presentOnScreens>true</presentOnScreens>
            <displayIndex>0</displayIndex>
            <EPICSAttributes>
               <EPICSRecord name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-TUPTIME" type="ai">
                  <EPICSField name="PREC" value="0"/>
                  <EPICSField name="HIGH" value="3153600000"/>
                  <EPICSField name="EGU" value="s"/>
                  <EPICSField name="DESC" value="Uptime of TCNd"/>
                  <EPICSField name="INP" value="@tcnd_uptime"/>
                  <EPICSField name="LOW" value="0"/>
                  <EPICSField name="DTYP" value="sysmon"/>
                  <EPICSField name="SCAN" value="I/O Intr"/>
               </EPICSRecord>
            </EPICSAttributes>
            <PULSEAttributes>
               <attribute name="isConfiguredByPulseScheduling">
                  <value>false</value>
               </attribute>
            </PULSEAttributes>
         </variableTemplate>
         <variableTemplate name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-TMAXOFF">
            <direction>state</direction>
            <kind>continuous</kind>
            <external>true</external>
            <raisesAlarm>false</raisesAlarm>
            <archivingInfo enabled="false">
               <samplingFrequency>0.0</samplingFrequency>
            </archivingInfo>
            <storage>volatile</storage>
            <presentOnScreens>true</presentOnScreens>
            <displayIndex>0</displayIndex>
            <EPICSAttributes>
               <EPICSRecord name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-TMAXOFF" type="ai">
