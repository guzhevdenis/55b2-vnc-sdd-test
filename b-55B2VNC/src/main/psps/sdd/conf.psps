                           <EPICSField name="INP" value="D1-I2-SYSM-55B2-A0:PCF0004-SYSHLT"/>
                           <EPICSField name="NIST" value="CPU, FD util high"/>
                           <EPICSField name="NISV" value="MINOR"/>
                           <EPICSField name="NIVL" value="9"/>
                           <EPICSField name="ONST" value="CPU utilization high"/>
                           <EPICSField name="ONSV" value="MINOR"/>
                           <EPICSField name="ONVL" value="1"/>
                           <EPICSField name="PINI" value="YES"/>
                           <EPICSField name="SCAN" value="Passive"/>
                           <EPICSField name="SVST" value="CPU, Mem, Disk util high"/>
                           <EPICSField name="SVSV" value="MINOR"/>
                           <EPICSField name="SVVL" value="7"/>
