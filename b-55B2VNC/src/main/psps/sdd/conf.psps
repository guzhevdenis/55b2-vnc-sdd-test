                           <EPICSField name="FFST" value="CPU,Mem,Disk,FD alarm"/>
                           <EPICSField name="FFSV" value="MINOR"/>
                           <EPICSField name="FFVL" value="15"/>
                           <EPICSField name="FRST" value="Disk utilization high"/>
                           <EPICSField name="FRSV" value="MINOR"/>
                           <EPICSField name="FRVL" value="4"/>
                           <EPICSField name="FTST" value="Mem, Disk, FD alarm"/>
                           <EPICSField name="FTSV" value="MINOR"/>
                           <EPICSField name="FTVL" value="14"/>
                           <EPICSField name="FVST" value="CPU, Disk util high"/>
