                     <displayIndex>0</displayIndex>
                     <EPICSAttributes>
                        <EPICSRecord name="D1-I2-SYSM-55B2-B0:PCF0003-SHLT"
                                      type="mbbi"
                                      createdAt="2025-10-20T16:12:51.628535"
                                      modifiedAt="2025-10-20T16:12:51.628535">
                           <EPICSField name="DESC" value="Synthesis Health Status"/>
                           <EPICSField name="INP" value="D1-I2-SYSM-55B2-B0:PCF0003-SHLTC"/>
                           <EPICSField name="ONST" value="Partially Operational(1)"/>
                           <EPICSField name="ONSV" value="MINOR"/>
                           <EPICSField name="ONVL" value="1"/>
                           <EPICSField name="PHAS" value="9"/>
                           <EPICSField name="PINI" value="YES"/>
                           <EPICSField name="SCAN" value="1 second"/>
                           <EPICSField name="THST" value="Not Operational"/>
                           <EPICSField name="THSV" value="MAJOR"/>
                           <EPICSField name="THVL" value="3"/>
                           <EPICSField name="TWST" value="Partially Operational(2)"/>
                           <EPICSField name="TWSV" value="MINOR"/>
                           <EPICSField name="TWVL" value="2"/>
                           <EPICSField name="ZRST" value="Fully Operational"/>
                           <EPICSField name="ZRSV" value="NO_ALARM"/>
                           <EPICSField name="ZRVL" value="0"/>
                        </EPICSRecord>
                     </EPICSAttributes>
                     <BEASTAttributes>
                        <pv xmlns="http://www.iter.org/CODAC/BEAST/2012"
                             name="D1-I2-SYSM-55B2-B0:PCF0003-SHLT">
                           <enabled>true</enabled>
                           <description>Any one of CPU, MEM, Disk, FD, Process of the host is in alarm state</description>
                           <latching>true</latching>
                           <annunciating>false</annunciating>
                           <delay>0</delay>
                           <guidance>
                              <title>System is an abnormal state</title>
                              <details>Check the mentioned alarm load and identify the cause</details>
                           </guidance>
                           <display>
                              <title>System Health Alarm OPI</title>
                              <details>/opt/codac/opi/boy/resources/alarmpages/healthMonitoring/ITER-SYSM-SHLT_Alarm.opi "CBS=D1-I2-SYSM, PPPP=55B2, PP=B0, TTT=PCF, NNNN=0003, ALARM_PV=D1-I2-SYSM-55B2-B0:PCF0003-SHLT, ALARM_PATH=/CODAC_AlarmHandler/D1/D1-I2/D1-I2-SYSM, LEVEL=ITER-D1-I2-SYSM, ALARM_GUIDANCE1_TITLE=System resource utilization is high, ALARM_GUIDANCE1_DETAILS=Any one of CPU / MEM / Disk / FD / Process of the host is in alarm state. Check the mentioned alarm load and identify the cause. If any load remains high continuously contact maintenance service."</details>
                           </display>
                           <guidance>
                              <title>System resources related to the alarm</title>
                              <details>1 - one of CPU, Disk, Memory, FD load is high or necessary process has been stopped
2 - two of CPU, Disk, Memory, FD load are high and/or necessary process has been stopped
3 - three of CPU, Disk, Memory, FD load are high and/or necessary process has been stopped</details>
                           </guidance>
                           <guidance>
                              <title>Corrective action</title>
                              <details>If any load remains high continuously, contact maintenance service.
                                        In addition, check if the necessary processes are running</details>
                           </guidance>
                           <guidance>
                              <title>Temporary actions to suppress</title>
                              <details>Change the alarm limits or severity for each load in alarm state.

  Ex1) alarm limits
	% caput D1-I2-SYSM-55B2-B0:PCF0003-CPUUTL.HIGH 90
	% caput D1-I2-SYSM-55B2-B0:PCF0003-CPUUTL.HIHI 100

  Ex2) alarm severity
	% caput D1-I2-SYSM-55B2-B0:PCF0003-MEMUTL.HSV NO_ALARM
	% caput D1-I2-SYSM-55B2-B0:PCF0003-MEMUTL.HHSV NO_ALARM</details>
                           </guidance>
                        </pv>
                     </BEASTAttributes>
                     <PULSEAttributes>
                        <attribute name="isConfiguredByPulseScheduling">
                           <value>false</value>
                        </attribute>
                     </PULSEAttributes>
