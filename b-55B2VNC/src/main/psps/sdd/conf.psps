         <variableTemplate name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-SHLTCS">
            <direction>state</direction>
            <kind>continuous</kind>
            <external>true</external>
            <raisesAlarm>false</raisesAlarm>
            <archivingInfo enabled="false">
               <samplingFrequency>0.0</samplingFrequency>
            </archivingInfo>
            <storage>volatile</storage>
            <presentOnScreens>false</presentOnScreens>
            <displayIndex>0</displayIndex>
            <EPICSAttributes>
               <EPICSRecord name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-SHLTCS" type="calcout">
                  <EPICSField name="PHAS" value="7"/>
                  <EPICSField name="INPA" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-SHLTCL"/>
                  <EPICSField name="CALC" value="A+(B&gt;=1?1:0)+(C&gt;=1?1:0)"/>
                  <EPICSField name="DESC" value="Calculation for synthesis health status"/>
                  <EPICSField name="SCAN" value="1 second"/>
                  <EPICSField name="FLNK" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-SHLTC"/>
                  <EPICSField name="INPC" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-CFA"/>
                  <EPICSField name="INPB" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-PICMG"/>
               </EPICSRecord>
            </EPICSAttributes>
            <PULSEAttributes>
               <attribute name="isConfiguredByPulseScheduling">
                  <value>false</value>
               </attribute>
            </PULSEAttributes>
