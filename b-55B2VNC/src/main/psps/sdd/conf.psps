         <variableTemplate name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-SYSHLTS">
            <direction>state</direction>
            <kind>discrete multi-state</kind>
            <external>true</external>
            <raisesAlarm>true</raisesAlarm>
            <archivingInfo enabled="true">
               <samplingMode>monitor</samplingMode>
               <samplingFrequency>1.0</samplingFrequency>
            </archivingInfo>
            <controlsArchivingGroup>false</controlsArchivingGroup>
            <storage>volatile</storage>
            <presentOnScreens>true</presentOnScreens>
            <displayIndex>0</displayIndex>
            <EPICSAttributes>
               <EPICSRecord name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-SYSHLTS" type="mbbi">
                  <EPICSField name="SCAN" value="Passive"/>
                  <EPICSField name="TTVL" value="13"/>
                  <EPICSField name="FTVL" value="14"/>
                  <EPICSField name="EIVL" value="8"/>
                  <EPICSField name="ELST" value="CPU, Mem, FD alarm"/>
                  <EPICSField name="ONSV" value="MINOR"/>
                  <EPICSField name="ZRST" value="OK"/>
                  <EPICSField name="NIST" value="CPU, FD util high"/>
                  <EPICSField name="SVSV" value="MINOR"/>
                  <EPICSField name="SXVL" value="6"/>
                  <EPICSField name="ZRVL" value="0"/>
                  <EPICSField name="FVST" value="CPU, Disk util high"/>
                  <EPICSField name="EISV" value="MINOR"/>
                  <EPICSField name="FRST" value="Disk utilization high"/>
                  <EPICSField name="SVST" value="CPU, Mem, Disk util high"/>
                  <EPICSField name="ELVL" value="11"/>
                  <EPICSField name="TWSV" value="MINOR"/>
                  <EPICSField name="ONVL" value="1"/>
                  <EPICSField name="FFSV" value="MINOR"/>
                  <EPICSField name="TVSV" value="MINOR"/>
                  <EPICSField name="VAL" value="15"/>
                  <EPICSField name="FVSV" value="MINOR"/>
                  <EPICSField name="DESC" value="System Health Summary"/>
                  <EPICSField name="SXST" value="Mem, Disk util high"/>
                  <EPICSField name="FTSV" value="MINOR"/>
                  <EPICSField name="THST" value="CPU, Mem util high"/>
                  <EPICSField name="UNSV" value="MINOR"/>
                  <EPICSField name="FRVL" value="4"/>
                  <EPICSField name="ZRSV" value="NO_ALARM"/>
                  <EPICSField name="TWST" value="Memory utilization high"/>
                  <EPICSField name="INP" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-SYSHLT"/>
                  <EPICSField name="TVVL" value="12"/>
                  <EPICSField name="THSV" value="MINOR"/>
                  <EPICSField name="TEVL" value="10"/>
                  <EPICSField name="FVVL" value="5"/>
                  <EPICSField name="TWVL" value="2"/>
                  <EPICSField name="TVST" value="Disk, FD util high"/>
                  <EPICSField name="ELSV" value="MINOR"/>
                  <EPICSField name="TEST" value="Mem, FD util high"/>
                  <EPICSField name="FFST" value="CPU,Mem,Disk,FD alarm"/>
                  <EPICSField name="TTSV" value="MINOR"/>
                  <EPICSField name="SXSV" value="MINOR"/>
                  <EPICSField name="NISV" value="MINOR"/>
                  <EPICSField name="TESV" value="MINOR"/>
                  <EPICSField name="ONST" value="CPU utilization high"/>
                  <EPICSField name="FTST" value="Mem, Disk, FD alarm"/>
                  <EPICSField name="FFVL" value="15"/>
                  <EPICSField name="FRSV" value="MINOR"/>
                  <EPICSField name="SVVL" value="7"/>
                  <EPICSField name="PINI" value="YES"/>
                  <EPICSField name="TTST" value="CPU, Disk, FD alarm"/>
                  <EPICSField name="EIST" value="FD utilization high"/>
                  <EPICSField name="THVL" value="3"/>
                  <EPICSField name="NIVL" value="9"/>
               </EPICSRecord>
            </EPICSAttributes>
            <BEASTAttributes>
               <pv xmlns="http://www.iter.org/CODAC/BEAST/2012"
                    name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-SYSHLTS">
                  <enabled>true</enabled>
                  <annunciating>false</annunciating>
                  <description>Any one of CPU, MEM, Disk or FD of the host is in alarm state</description>
                  <latching>true</latching>
                  <delay>0</delay>
                  <guidance>
                     <details>1 - CPU utilization high (CPUUTL) : CPU utilization is high
2 - Memory utilization high (MEMUTL) : Memory utilization is high
3 - CPU, Mem util high (CPUUTL, MEMUTL) : CPU and Memory utilizations are high
4 - Disk utilization high (DISKUTL) : Disk utilizations are high
5 - CPU, Disk util high (CPUUTL,DISKUTL) : CPU and Disk utilizations are high
6 - Mem, Disk util high (MEMUTL,DISKUTL) : Memory and Disk utilizations are high
7 - CPU, Mem, Disk util high (CPUUTL,MEMUTL,DISKUTL) : CPU/Memory/Disk utilizations are high
8 - FD utilization high (FDUTL) : FD utilization is high
9 - CPU, FD util high (CPUUTL,FDUTL) : CPU and FD are in alarm state
10 - Mem, FD util high (MEMUTL,FDUTL) : Memory and FD are in alarm state
11 - CPU, Mem, FD alarm (CPUUTL,MEMUTL,FDUTL) : CPU/Memory/FD are in alarm state
12 - Disk, FD util high (DISKUTL,FDUTL) : Disk and FD are in alarm state
13 - CPU, Disk, FD alarm (CPUUTL,DISKUTL,FDUTL) : CPU/Disk/FD are in alarm state
14 - Mem, Disk, FD alarm (MEMUTL,DISKUTL,FDUTL) : Memory/Disk/FD are in alarm state
15 - CPU,Mem,Disk,FD alarm (CPUUTL,MEMUTL,DISKUTL,FDUTL) : CPU/Memory/Disk/FD alarm</details>
                     <title>System resources related to the alarm</title>
                  </guidance>
                  <guidance>
                     <details>Check the mentioned alarm load and identify the cause</details>
                     <title>System resource utilization is high</title>
                  </guidance>
                  <guidance>
                     <title>Temporary actions to suppress</title>
                     <details>Change the alarm limits or severity for each load in alarm state.

  Ex1) alarm limits
	% caput $(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-CPUUTL.HIGH 90
	% caput $(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-CPUUTL.HIHI 100

  Ex2) alarm severity
	% caput $(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-MEMUTL.HSV NO_ALARM
	% caput $(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-MEMUTL.HHSV NO_ALARM</details>
                  </guidance>
                  <guidance>
                     <details>If any load remains high continuously, contact maintenance service</details>
                     <title>Corrective action</title>
                  </guidance>
                  <display>
                     <title>System Health Alarm OPI</title>
                     <details>/opt/codac/opi/boy/resources/alarmpages/healthMonitoring/ITER-SYSM-SYSHLTS_Alarm.opi "CBS=$(CBS), PPPP=$(PPPP), PP=$(PP), TTT=$(TTT), NNNN=$(NNNN), ALARM_PV=$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-SYSHLTS, ALARM_PATH=$(ALARM_PATH), LEVEL=$(BOY_LEVEL), ALARM_GUIDANCE1_TITLE=System resource utilization is high, ALARM_GUIDANCE1_DETAILS=Any one of CPU / MEM / Disk / FD of the host is in alarm state. Check the mentioned alarm load and identify the cause. If any load remains high continuously contact maintenance service."</details>
                  </display>
               </pv>
            </BEASTAttributes>
            <PULSEAttributes>
               <attribute name="isConfiguredByPulseScheduling">
                  <value>false</value>
               </attribute>
            </PULSEAttributes>
         </variableTemplate>
         <variableTemplate name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-IPADDR">
